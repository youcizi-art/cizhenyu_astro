---
interface Item {
  title: string;
  description: string;
}
interface Props {
  title?: string;
  subtitle?: string;
  items?: Item[];
}
const { title = '', subtitle = '', items = [] } = Astro.props;
---
{items.length > 0 ? (
  <section class="tm-advantage">
    <div class="tm-title-wrap">
      {title ? <h2 class="tm-title-main tm-title-on-dark">{title}</h2> : null}
      {subtitle ? <p class="tm-title-desc tm-title-desc-on-dark">{subtitle}</p> : null}
    </div>
    <div class="tm-container tm-grid-3">
      {items.map((item) => (
        <article class="tm-advantage-card">
          <h3 class="tm-display">{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>
) : null}
