---
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import ProductSeoSections from '@/ui/blocks/ProductSeoSections.astro';
import DefaultProductDetailPage from './default/pages/ProductDetailPage.astro';
import TurmillProductDetailPage from './turmill/pages/ProductDetailPage.astro';
import { getThemeMeta } from './theme-ui';
import { t } from '@/modules/i18n';
import type { ProductDetail } from '@/modules/product';
import type { PageChrome } from '@/workflows/chrome/load-chrome';

interface Props {
  chrome: PageChrome;
  product: ProductDetail | null;
  error?: string;
}
const { chrome, product, error } = Astro.props;
const meta = getThemeMeta(chrome.site.theme);
const backHref = `/${chrome.locale}/products`;
const zh = chrome.locale.startsWith('zh');
const specsTitle = zh ? '模块信息' : 'Module details';
const inquiryTitle = zh ? '模块询盘' : 'Module inquiry';
const inquiryBody = zh
  ? '告诉我们您的行业与现状，获取该模块的部署与组合建议。价格不在线公示。'
  : 'Share your industry and status for a module plan. Pricing is not listed publicly.';
const sectionLabels = {
  advantages: zh ? '核心能力' : 'Key capabilities',
  video: zh ? '产品视频' : 'Product Video',
  application: zh ? '适用场景' : 'Applications',
  howItWorks: zh ? '如何协作' : 'How it works',
  capacity: zh ? '交付能力' : 'Delivery',
  oem: 'OEM / ODM',
  quality: zh ? '质量与可控' : 'Quality & control',
  certifications: zh ? '认证' : 'Certifications',
  faqs: 'FAQ',
  industries: zh ? '适用角色' : 'Ideal for',
  relatedProducts: zh ? '相关模块' : 'Related modules',
  relatedCases: zh ? '相关案例' : 'Related Cases',
  relatedArticles: zh ? '相关文章' : 'Guides & Articles',
  inquiryTitle,
  inquiryBody,
  inquiryCta: product?.inquiryLabel || t(chrome.locale, 'contact'),
};
const shared = {
  product,
  backHref,
  backLabel: `← ${t(chrome.locale, 'products')}`,
  homeHref: `/${chrome.locale}`,
  homeLabel: t(chrome.locale, 'home'),
  listLabel: t(chrome.locale, 'products'),
  specsTitle,
  inquiryTitle,
  inquiryBody,
  contactHref: product?.inquiryHref || `/${chrome.locale}/contact`,
  contactLabel: sectionLabels.inquiryCta,
  sectionLabels,
  error,
  warnings: chrome.warnings,
};
---
{meta.id === 'default' ? (
  <DefaultProductDetailPage {...shared} />
) : meta.id === 'turmill' ? (
  <TurmillProductDetailPage {...shared} />
) : (
  <>
    <p><a href={backHref}>← {t(chrome.locale, 'products')}</a></p>
    <AlertBanner messages={error ? [error] : []} />
    <AlertBanner messages={chrome.warnings} tone="warn" />
    {product ? (
      <article>
        <h1>{product.title}</h1>
        {product.sku ? <p class="muted">SKU: {product.sku}</p> : null}
        {product.brand ? <p class="muted">{product.brand}</p> : null}
        {product.coverUrl ? (
          <p><img class="card-media" src={product.coverUrl} alt={product.title} /></p>
        ) : null}
        {product.summary ? <p>{product.summary}</p> : null}
        {product.descriptionHtml ? <div class="prose" set:html={product.descriptionHtml} /> : null}
        <ProductSeoSections product={product} labels={sectionLabels} />
      </article>
    ) : null}
  </>
)}
