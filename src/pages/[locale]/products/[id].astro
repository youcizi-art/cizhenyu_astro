---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import ThemeFrame from '@/ui/themes/ThemeFrame.astro';
import ActiveProductDetail from '@/ui/themes/ActiveProductDetail.astro';
import { loadProductDetailPage } from '@/workflows/products/load-product-detail';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { layoutSeoProps, pageJsonLd, resolveEntityLocaleAlternates, siteOrigin } from '@/modules/seo';
import { localePath } from '@/modules/cms';
import { t, defaultLocaleHref } from '@/modules/i18n';

export const prerender = false;

const id = String(Astro.params.id || '').trim();
const data = await loadProductDetailPage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
  id,
});
if (!data.localeValid) {
  return Astro.redirect(defaultLocaleHref("/products"), 302);
}
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled) return Astro.rewrite('/404');
if (!data.error && !data.product) return Astro.rewrite('/404');
const product = data.product;
const origin = siteOrigin() || Astro.url.origin;
const title = product ? `${product.seoTitle} · ${data.siteName}` : `Product · ${data.siteName}`;
const seoProps = layoutSeoProps(product?.seo, Astro.url.pathname);
const company = {
  name: data.company.name,
  address: data.company.address,
  country: data.company.country,
  phone: data.company.phone,
  email: data.company.email,
  website: data.company.website,
  logoUrl: data.company.logoUrl,
  foundingDate: data.company.foundingDate,
  sameAs: data.company.sameAs,
};
const alternates = product
  ? await resolveEntityLocaleAlternates({
      catalogKey: 'product',
      languageGroupKey: product.languageGroupKey,
      locales: data.languages.map((item) => item.code),
      defaultLocale: data.site.defaultLocale,
      currentLocale: data.locale,
      currentPath: Astro.url.pathname,
      pathForSlug: (locale, slug) => localePath(locale, `/products/${encodeURIComponent(slug)}`),
      origin,
    })
  : [];
const jsonLd = product
  ? pageJsonLd(
      {
        ...product.seo,
        geoLat: product.seo.geoLat || data.company.geoLat,
        geoLng: product.seo.geoLng || data.company.geoLng,
      },
      Astro.url.pathname,
      {
        siteName: data.siteName,
        company,
        breadcrumbs: [
          { name: t(data.locale, 'home'), href: `/${data.locale}` },
          { name: t(data.locale, 'products'), href: `/${data.locale}/products` },
          { name: product.title },
        ],
        product: {
          name: product.title,
          description: product.summary || product.seoDescription,
          sku: product.sku,
          brand: product.brand,
          imageUrls: product.imageUrls,
          specs: product.specs,
          price: product.price,
          currency: product.currency,
          availability: product.availability,
        },
        faqs: product.faqs.map((item) => ({ question: item.question, answer: item.answer })),
      }
    )
  : null;
---
<BaseLayout
  title={title}
  description={product?.seoDescription || ''}
  lang={data.locale}
  siteName={data.siteName}
  alternates={alternates}
  {...seoProps}
  jsonLd={jsonLd}
>
  <ThemeFrame chrome={data}>
    <ActiveProductDetail chrome={data} product={product} error={data.error} />
  </ThemeFrame>
</BaseLayout>
