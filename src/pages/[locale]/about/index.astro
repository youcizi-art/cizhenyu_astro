---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import SiteHeader from '@/ui/layout/SiteHeader.astro';
import SiteFooter from '@/ui/layout/SiteFooter.astro';
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import { loadAboutPage } from '@/workflows/pages/load-static-pages';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { buildAlternateLinks } from '@/workflows/chrome/urls';

export const prerender = false;

const data = await loadAboutPage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
});
if (!data.localeValid) {
  return Astro.redirect(`/${data.site.defaultLocale}/about`, 302);
}
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled) return new Response('Not Found', { status: 404 });
---
<BaseLayout
  title={`${data.page?.seoTitle || data.page?.title || data.labels.about} · ${data.siteName}`}
  description={data.page?.seoDescription || data.page?.summary || data.company.summary}
  lang={data.locale}
  alternates={buildAlternateLinks(data.localeOptions)}
>
  <SiteHeader
    siteName={data.siteName}
    links={data.navLinks}
    localeOptions={data.localeOptions}
    languageLabel={data.languageLabel}
  />
  <main class="wrap">
    <AlertBanner messages={data.error ? [data.error] : []} />
    <AlertBanner messages={data.warnings} tone="warn" />
    <h1>{data.page?.title || data.labels.about}</h1>
    {data.company.logoUrl ? (
      <p><img src={data.company.logoUrl} alt={data.siteName} style="max-height:72px" /></p>
    ) : null}
    {data.company.slogan ? <p class="muted">{data.company.slogan}</p> : null}
    {data.company.summary ? <p>{data.company.summary}</p> : null}
    <section class="section card">
      {data.company.address ? <p>{data.company.address}</p> : null}
      {data.company.phone ? <p>{data.company.phone}</p> : null}
      {data.company.email ? <p><a href={`mailto:${data.company.email}`}>{data.company.email}</a></p> : null}
      {data.company.website ? <p><a href={data.company.website}>{data.company.website}</a></p> : null}
    </section>
    {data.page?.content ? <div class="section prose" set:html={data.page.content} /> : null}
    {!data.page && !data.company.summary && !data.error ? (
      <p class="muted">请在 CMS 创建 slug 为 about 的独立页面，或完善公司信息。</p>
    ) : null}
  </main>
  <SiteFooter company={data.company} />
</BaseLayout>
