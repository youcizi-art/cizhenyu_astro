---
import OptimizedImage from '@/ui/components/OptimizedImage.astro';

interface Item {
  title: string;
  href: string;
  summary?: string;
  coverUrl?: string;
}
interface Props {
  title?: string;
  eyebrow?: string;
  subtitle?: string;
  items?: Item[];
  readMoreText?: string;
  /** home: overlay title like live site; list: classic card body */
  variant?: 'home' | 'list';
}
const {
  title = 'Products',
  eyebrow = '',
  subtitle = '',
  items = [],
  readMoreText = 'Learn More',
  variant = 'home',
} = Astro.props;
---
{items.length > 0 ? (
  <section class={`tm-section tm-section-white tm-products-${variant}`} id="products">
    {title || subtitle || eyebrow ? (
      <div class="tm-title-wrap">
        {eyebrow ? <div class="tm-title-eyebrow">{eyebrow}</div> : null}
        {title ? <h2 class="tm-title-main">{title}</h2> : null}
        {subtitle ? <p class="tm-title-desc">{subtitle}</p> : null}
      </div>
    ) : null}
    <div class="tm-container tm-grid-3">
      {items.map((item) => (
        variant === 'home' ? (
          <article class="tm-product-tile">
            <a class="tm-product-tile-media tm-img-cover" href={item.href} aria-label={item.title}>
              {item.coverUrl ? (
                <OptimizedImage
                  src={item.coverUrl}
                  alt={item.title}
                  width={640}
                  height={480}
                  widths={[320, 640, 960]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  fill
                />
              ) : null}
              <span class="tm-product-tile-title">{item.title}</span>
            </a>
          </article>
        ) : (
          <article class="tm-product-card tm-card-hover">
            <a class="tm-product-cover tm-img-cover" href={item.href} aria-label={item.title}>
              {item.coverUrl ? (
                <OptimizedImage
                  src={item.coverUrl}
                  alt={item.title}
                  width={640}
                  height={400}
                  widths={[320, 640, 960]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  fill
                />
              ) : null}
            </a>
            <div class="tm-product-body">
              <h3><a href={item.href}>{item.title}</a></h3>
              {item.summary ? <p>{item.summary}</p> : null}
              <a class="tm-link-more" href={item.href}>{readMoreText} <span>→</span></a>
            </div>
          </article>
        )
      ))}
    </div>
  </section>
) : null}
