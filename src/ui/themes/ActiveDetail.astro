---
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import GeoAnswer from '@/ui/blocks/GeoAnswer.astro';
import RelatedLinks from '@/ui/blocks/RelatedLinks.astro';
import { getThemeMeta } from './theme-ui';
import { t } from '@/modules/i18n';
import type { PageChrome } from '@/workflows/chrome/load-chrome';

interface Props {
  chrome: PageChrome;
  kind: 'article' | 'caseStudy' | 'solution' | 'resource';
  title: string;
  summary?: string;
  content?: string;
  coverUrl?: string;
  backHref: string;
  listLabel: string;
  article?: any;
  caseItem?: any;
  error?: string;
}
const { chrome, kind, title, summary = '', content = '', coverUrl = '', backHref, listLabel, article, caseItem, error } = Astro.props;
const meta = getThemeMeta(chrome.site.theme);
const homeHref = `/${chrome.locale}`;
const homeLabel = t(chrome.locale, 'home');
const zh = chrome.locale.startsWith('zh');
const shortAnswerLabel = zh ? '简答' : chrome.locale === 'ja' ? '簡潔な回答' : 'Short answer';
const relatedArticlesTitle = zh ? '相关文章' : chrome.locale === 'ja' ? '関連記事' : 'Related Articles';
const relatedIndustriesTitle = zh ? '相关行业' : chrome.locale === 'ja' ? '関連業界' : 'Related Industries';
const relatedProductsTitle = zh ? '相关产品' : chrome.locale === 'ja' ? '関連製品' : 'Related Products';
const articleShortAnswer = kind === 'article' ? String(article?.shortAnswer || '').trim() : '';
const relatedArticles = Array.isArray(article?.relatedArticles) ? article.relatedArticles : [];
const articleProducts = Array.isArray(article?.relatedProducts) ? article.relatedProducts : [];
const articleIndustries = Array.isArray(article?.relatedIndustries) ? article.relatedIndustries : [];
const caseIndustries = Array.isArray(caseItem?.industries) ? caseItem.industries : [];
const caseProducts = Array.isArray(caseItem?.relatedProducts) ? caseItem.relatedProducts : [];
const isShellTheme = true;

const articleDetailModules = import.meta.glob<{ default: any }>('./*/pages/ArticleDetailPage.astro', { eager: true });
const caseStudyDetailModules = import.meta.glob<{ default: any }>('./*/pages/CaseStudyDetailPage.astro', { eager: true });
const simpleDetailModules = import.meta.glob<{ default: any }>('./*/pages/SimpleDetailPage.astro', { eager: true });

const TargetArticleDetail = articleDetailModules[`./${meta.id}/pages/ArticleDetailPage.astro`]?.default || articleDetailModules['./default/pages/ArticleDetailPage.astro']?.default;
const TargetCaseStudyDetail = caseStudyDetailModules[`./${meta.id}/pages/CaseStudyDetailPage.astro`]?.default || caseStudyDetailModules['./default/pages/CaseStudyDetailPage.astro']?.default;
const TargetSimpleDetail = simpleDetailModules[`./${meta.id}/pages/SimpleDetailPage.astro`]?.default || simpleDetailModules['./default/pages/SimpleDetailPage.astro']?.default;
---
{articleShortAnswer ? (
  <GeoAnswer title={shortAnswerLabel} shortAnswer={articleShortAnswer} />
) : null}
{kind === 'article' && TargetArticleDetail ? (
  <TargetArticleDetail
    article={article}
    backHref={backHref}
    backLabel={`← ${listLabel}`}
    homeHref={homeHref}
    homeLabel={homeLabel}
    listLabel={listLabel}
    locale={chrome.locale}
    contactHref={`/${chrome.locale}/contact`}
    contactLabel={t(chrome.locale, 'contact')}
    relatedTitle={relatedArticlesTitle}
    related={relatedArticles.map((item: { title: string; href: string }) => ({
      title: item.title,
      href: item.href,
    }))}
    sidebarTitle={zh ? '需要方案？' : 'Need a plan?'}
    sidebarBody={chrome.company.summary || (zh
      ? '提交询盘，获取适合您阶段的模块组合建议。'
      : 'Inquire for a module mix that matches your stage.')}
    error={error}
    warnings={chrome.warnings}
  />
) : kind === 'caseStudy' && TargetCaseStudyDetail ? (
  <TargetCaseStudyDetail
    item={caseItem}
    backHref={backHref}
    backLabel={`← ${listLabel}`}
    homeHref={homeHref}
    homeLabel={homeLabel}
    listLabel={listLabel}
    labels={{
      challenge: zh ? '挑战' : 'Challenge',
      solution: zh ? '方案' : 'Solution',
      results: zh ? '成果' : 'Results',
    }}
    error={error}
    warnings={chrome.warnings}
  />
) : TargetSimpleDetail ? (
  <TargetSimpleDetail
    title={title}
    summary={summary}
    content={content}
    coverUrl={coverUrl}
    backHref={backHref}
    backLabel={`← ${listLabel}`}
    homeHref={homeHref}
    homeLabel={homeLabel}
    listLabel={listLabel}
    error={error}
    warnings={chrome.warnings}
  />
) : (
  <>
    <p><a href={backHref}>← {listLabel}</a></p>
    <AlertBanner messages={error ? [error] : []} />
    <AlertBanner messages={chrome.warnings} tone="warn" />
    <h1>{title}</h1>
    {coverUrl ? <p><img class="card-media" src={coverUrl} alt={title} /></p> : null}
    {summary ? <p>{summary}</p> : null}
    {content ? <div class="prose" set:html={content} /> : null}
  </>
)}
{kind === 'article' && !isShellTheme ? (
  <RelatedLinks title={relatedArticlesTitle} items={relatedArticles} />
) : null}
{kind === 'article' && !isShellTheme ? (
  <>
    <RelatedLinks title={relatedProductsTitle} items={articleProducts} />
    <RelatedLinks title={relatedIndustriesTitle} items={articleIndustries} />
  </>
) : null}
{kind === 'caseStudy' && !isShellTheme ? (
  <>
    <RelatedLinks title={relatedIndustriesTitle} items={caseIndustries} />
    <RelatedLinks title={relatedProductsTitle} items={caseProducts} />
  </>
) : null}
