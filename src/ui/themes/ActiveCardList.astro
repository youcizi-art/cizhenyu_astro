---
/**
 * 通用列表页主题切换（文章/案例/方案/资料）
 */
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import Pagination from '@/ui/blocks/Pagination.astro';
import DefaultArticleListPage from './default/pages/ArticleListPage.astro';
import DefaultCaseStudyListPage from './default/pages/CaseStudyListPage.astro';
import DefaultDownloadListPage from './default/pages/DownloadListPage.astro';
import DefaultSimpleCardListPage from './default/pages/SimpleCardListPage.astro';
import TurmillArticleListPage from './turmill/pages/ArticleListPage.astro';
import TurmillCaseStudyListPage from './turmill/pages/CaseStudyListPage.astro';
import TurmillSimpleCardListPage from './turmill/pages/SimpleCardListPage.astro';
import { getThemeMeta } from './theme-ui';
import { t } from '@/modules/i18n';
import type { PublicPages } from '@/modules/cms';
import type { PageChrome } from '@/workflows/chrome/load-chrome';

type CardItem = {
  title: string;
  href: string;
  summary?: string;
  coverUrl?: string;
  meta?: string;
  author?: string;
  industry?: string;
  clientName?: string;
};

interface Props {
  chrome: PageChrome;
  kind: 'articles' | 'caseStudies' | 'solutions' | 'resources';
  title: string;
  items: CardItem[];
  pages: PublicPages;
  basePath: string;
  emptyText: string;
  typeLinks?: Array<{ title: string; href: string }>;
  error?: string;
}
const { chrome, kind, title, items, pages, basePath, emptyText, typeLinks = [], error } = Astro.props;
const meta = getThemeMeta(chrome.site.theme);
const homeHref = `/${chrome.locale}`;
const homeLabel = t(chrome.locale, 'home');
const readMore = chrome.locale.startsWith('zh') ? '了解更多' : 'Learn More';
const isDefault = meta.id === 'default';
const isTurmill = meta.id === 'turmill';
---
{isDefault && kind === 'articles' ? (
  <DefaultArticleListPage
    title={title}
    items={items as any}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    readMoreText={chrome.locale.startsWith('zh') ? '阅读更多' : 'Read More'}
    typeLinks={typeLinks}
    error={error}
    warnings={chrome.warnings}
  />
) : isDefault && kind === 'caseStudies' ? (
  <DefaultCaseStudyListPage
    title={title}
    items={items as any}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    error={error}
    warnings={chrome.warnings}
  />
) : isDefault && kind === 'resources' ? (
  <DefaultDownloadListPage
    title={title}
    items={items.map((item) => ({
      ...item,
      inquiryHref: `${homeHref}/contact?intent=download&from=${encodeURIComponent(item.href)}`,
    }))}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    lead={
      chrome.locale.startsWith('zh')
        ? '下载安装包将进入询盘；客服可协作完成安装与初始化。正式安装包通过询盘交付。'
        : 'Download opens inquiry — we can collaborate on install. Packages are delivered after inquiry.'
    }
    downloadLabel={chrome.locale.startsWith('zh') ? '下载 / 询盘' : 'Download / Inquire'}
    error={error}
    warnings={chrome.warnings}
  />
) : isDefault ? (
  <DefaultSimpleCardListPage
    title={title}
    items={items}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    readMoreText={readMore}
    error={error}
    warnings={chrome.warnings}
  />
) : isTurmill && kind === 'articles' ? (
  <TurmillArticleListPage
    title={title}
    items={items as any}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    readMoreText={chrome.locale.startsWith('zh') ? '阅读更多' : 'Read More'}
    typeLinks={typeLinks}
    error={error}
    warnings={chrome.warnings}
  />
) : isTurmill && kind === 'caseStudies' ? (
  <TurmillCaseStudyListPage
    title={title}
    items={items as any}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    error={error}
    warnings={chrome.warnings}
  />
) : isTurmill ? (
  <TurmillSimpleCardListPage
    title={title}
    items={items}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    readMoreText={readMore}
    error={error}
    warnings={chrome.warnings}
  />
) : (
  <>
    <h1>{title}</h1>
    <AlertBanner messages={error ? [error] : []} />
    <AlertBanner messages={chrome.warnings} tone="warn" />
    <div class="card-list">
      {items.map((item) => (
        <article class="card">
          {item.coverUrl ? <img class="card-media" src={item.coverUrl} alt={item.title} loading="lazy" /> : null}
          <h2><a href={item.href}>{item.title}</a></h2>
          {item.summary ? <p>{item.summary}</p> : null}
        </article>
      ))}
    </div>
    {!error && !items.length ? <p class="muted">{emptyText}</p> : null}
    {!error ? <Pagination pages={pages} basePath={basePath} /> : null}
  </>
)}
