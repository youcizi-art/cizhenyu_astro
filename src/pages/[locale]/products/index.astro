---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import SiteHeader from '@/ui/layout/SiteHeader.astro';
import SiteFooter from '@/ui/layout/SiteFooter.astro';
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import Pagination from '@/ui/blocks/Pagination.astro';
import { loadProductListPage } from '@/workflows/products/load-product-list';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { buildAlternateLinks } from '@/workflows/chrome/urls';
import { t } from '@/modules/i18n';

export const prerender = false;

const page = Number(Astro.url.searchParams.get('page') || 1) || 1;
const data = await loadProductListPage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
  page,
});
if (!data.localeValid) {
  return Astro.redirect(`/${data.site.defaultLocale}/products`, 302);
}
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled) return new Response('Not Found', { status: 404 });
const title = `${t(data.locale, 'products')} · ${data.siteName}`;
---
<BaseLayout
  title={title}
  description={data.company.summary}
  lang={data.locale}
  alternates={buildAlternateLinks(data.localeOptions)}
>
  <SiteHeader
    siteName={data.siteName}
    links={data.navLinks}
    localeOptions={data.localeOptions}
    languageLabel={data.languageLabel}
  />
  <main class="wrap">
    <h1>{t(data.locale, 'products')}</h1>
    <AlertBanner messages={data.error ? [data.error] : []} />
    <AlertBanner messages={data.warnings} tone="warn" />
    <div class="card-list">
      {data.items.map((item) => (
        <article class="card">
          {item.coverUrl ? <img class="card-media" src={item.coverUrl} alt={item.title} loading="lazy" /> : null}
          <h2><a href={item.href}>{item.title}</a></h2>
          {item.sku ? <p class="muted">SKU: {item.sku}</p> : null}
          {item.summary ? <p>{item.summary}</p> : null}
        </article>
      ))}
    </div>
    {!data.error && !data.items.length ? <p class="muted">{t(data.locale, 'emptyProducts')}</p> : null}
    {!data.error ? <Pagination pages={data.pages} basePath={`/${data.locale}/products`} /> : null}
  </main>
  <SiteFooter company={data.company} />
</BaseLayout>
