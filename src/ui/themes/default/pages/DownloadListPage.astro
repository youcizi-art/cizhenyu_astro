---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { PublicPages } from '@/modules/cms';

interface CardItem {
  title: string;
  href: string;
  summary?: string;
  coverUrl?: string;
  meta?: string;
  inquiryHref?: string;
}
interface Props {
  title: string;
  items: CardItem[];
  pages?: PublicPages;
  basePath?: string;
  emptyText?: string;
  homeHref: string;
  homeLabel?: string;
  lead?: string;
  downloadLabel?: string;
  error?: string;
  warnings?: string[];
}
const {
  title,
  items,
  pages,
  basePath = '',
  emptyText = '暂无下载。',
  homeHref,
  homeLabel = '首页',
  lead = '下载安装包将进入询盘；客服可协作完成安装与初始化。',
  downloadLabel = '下载 / 询盘',
  error,
  warnings = [],
} = Astro.props;

const totalPages = Math.max(1, pages?.totalPages || 1);
const page = Math.max(1, pages?.page || 1);
const prevHref = pages && page > 1 ? `${basePath}?page=${page - 1}` : '';
const nextHref = pages && page < totalPages ? `${basePath}?page=${page + 1}` : '';
---
<PageBanner
  title={title}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: title },
  ]}
/>
<section class="cz-page-section">
  <div class="cz-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
    {lead ? <p style="color:var(--muted);max-width:40rem;margin:0 0 1.5rem">{lead}</p> : null}
    {!error && !items.length ? <p style="color:var(--muted)">{emptyText}</p> : null}
    {items.length ? (
      <div class="cz-download-grid">
        {items.map((item) => {
          const actionHref =
            item.inquiryHref ||
            `${homeHref.replace(/\/$/, '')}/contact?intent=download&from=${encodeURIComponent(item.href)}`;
          return (
            <article class="cz-card cz-product-card cz-download-card">
              <div class="cz-product-cover">
                {item.coverUrl ? (
                  <OptimizedImage
                    src={item.coverUrl}
                    alt={item.title}
                    width={640}
                    height={400}
                    widths={[320, 640]}
                    sizes="(max-width: 768px) 100vw, 33vw"
                  />
                ) : null}
              </div>
              <div class="cz-product-body">
                <h3>{item.title}</h3>
                {item.meta ? (
                  <p style="color:var(--accent);font-size:0.8rem;font-weight:700;margin:0">{item.meta}</p>
                ) : null}
                {item.summary ? <p>{item.summary}</p> : null}
                <a class="cz-btn cz-btn-primary" href={actionHref}>{downloadLabel}</a>
                <a class="cz-more" href={item.href}>了解详情 →</a>
              </div>
            </article>
          );
        })}
      </div>
    ) : null}
    {pages && totalPages > 1 ? (
      <div class="cz-pager" style="margin-top:1.5rem;display:flex;gap:1rem;align-items:center">
        {prevHref ? <a class="cz-more" href={prevHref}>← Prev</a> : null}
        <span>Page {page} / {totalPages}</span>
        {nextHref ? <a class="cz-more" href={nextHref}>Next →</a> : null}
      </div>
    ) : null}
  </div>
</section>
