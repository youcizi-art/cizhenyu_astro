---
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import type { NavLink } from '@/modules/nav';
import type { CompanyView } from '@/modules/company';

import { t } from '@/modules/i18n';

interface Props {
  siteName: string;
  links: NavLink[];
  localeOptions?: Array<{ code: string; name: string; href: string; active: boolean }>;
  company: CompanyView;
  locale: string;
  homeHref: string;
  contactHref: string;
  contactLabel: string;
  showContactCta?: boolean;
  quickLinksLabel?: string;
}
const {
  siteName,
  links,
  localeOptions = [],
  company,
  locale,
  homeHref,
  contactHref,
  contactLabel,
  showContactCta = true,
  quickLinksLabel,
} = Astro.props;

const resolvedQuickLinks = quickLinksLabel || t(locale, 'quickLinks');
---
<!-- 第三方脚本：load + idle 后再注入，避免与首屏 LCP 抢带宽（preload scanner 看不到静态 script src） -->
<script is:inline>
  (function () {
    var GA_ID = 'AW-18534098548';
    var WIDGET_HOST = 'https://chat.ycz.me';
    var WIDGET_SRC = WIDGET_HOST + '/widget.js';

    function injectGtag() {
      if (window.__czGtagScheduled) return;
      window.__czGtagScheduled = true;
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', GA_ID);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
      document.head.appendChild(s);
    }

    function injectWidget() {
      if (window.__czWidgetScheduled) return;
      window.__czWidgetScheduled = true;
      window.__CF_IM_HOST__ = WIDGET_HOST;
      var s = document.createElement('script');
      s.src = WIDGET_SRC;
      s.defer = true;
      document.body.appendChild(s);
    }
    // 用户点击咨询时立即拉挂件（不必等 idle）
    window.__czLoadChatWidget = injectWidget;

    function afterIdle(fn, timeout) {
      var ric = window.requestIdleCallback;
      if (typeof ric === 'function') {
        ric(fn, { timeout: timeout || 4000 });
      } else {
        setTimeout(fn, Math.min(timeout || 4000, 2000));
      }
    }

    function bootThirdParty() {
      afterIdle(injectWidget, 3500);
      afterIdle(injectGtag, 5000);
    }

    if (document.readyState === 'complete') bootThirdParty();
    else window.addEventListener('load', bootThirdParty, { once: true });
  })();
</script>

<Header
  siteName={siteName}
  links={links}
  localeOptions={localeOptions}
  company={company}
  homeHref={homeHref}
  contactHref={contactHref}
  contactLabel={contactLabel}
  showContactCta={showContactCta}
/>
<main class="cz-main">
  <slot />
</main>
<Footer company={company} links={links} locale={locale} quickLinksLabel={resolvedQuickLinks} />

<script is:inline>
  (function () {
    /**
     * 响应页面中所有带 [data-cf-chat] 的交互按钮或链接
     * 支持直接打开、携带产品参数与自定义事件广播
     */
    function triggerChatOpen(trigger) {
      var productTitle = trigger.getAttribute('data-product-title') || '';
      var productPrice = trigger.getAttribute('data-product-price') || '';
      var productSku = trigger.getAttribute('data-product-sku') || '';
      var initialMsg = trigger.getAttribute('data-initial-message') || '';

      var payload = undefined;
      if (productTitle || productPrice || productSku || initialMsg) {
        payload = {};
        if (productTitle || productPrice || productSku) {
          payload.product = {
            title: productTitle,
            price: productPrice,
            sku: productSku
          };
        }
        if (initialMsg) {
          payload.initialMessage = initialMsg;
        } else if (productTitle) {
          var docLang = (document.documentElement.lang || '').toLowerCase();
          if (docLang.startsWith('en')) {
            payload.initialMessage = 'Hello, I am interested in [' + productTitle + '], please share more details.';
          } else if (docLang.startsWith('ja')) {
            payload.initialMessage = 'こんにちは、【' + productTitle + '】について詳細を伺いたいです。';
          } else if (docLang.includes('tw') || docLang.includes('hk')) {
            payload.initialMessage = '你好，我對【' + productTitle + '】很感興趣，想了解更多細節。';
          } else {
            payload.initialMessage = '你好，我对【' + productTitle + '】很感兴趣，想了解更多细节。';
          }
        }
      }

      function executeOpen() {
        if (window.CFIMChat && typeof window.CFIMChat.open === 'function') {
          if (payload) {
            window.CFIMChat.open(payload);
          } else {
            window.CFIMChat.open();
          }
          return true;
        }
        return false;
      }

      // 广播 CustomEvent 事件
      try {
        window.dispatchEvent(
          new CustomEvent('cf-chat:open', {
            detail: {
              productTitle: productTitle,
              productPrice: productPrice,
              productSku: productSku,
              payload: payload
            }
          })
        );
      } catch (err) {}

      if (typeof window.__czLoadChatWidget === 'function') {
        window.__czLoadChatWidget();
      }

      // 若客服挂件已加载完毕则立即打开；否则进行重试轮询
      if (!executeOpen()) {
        var retries = 0;
        var intervalId = setInterval(function () {
          retries++;
          if (executeOpen() || retries > 40) {
            clearInterval(intervalId);
          }
        }, 120);
      }
    }

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;
      var trigger = target.closest('[data-cf-chat="open"], [data-cf-chat], a[href="#chat"]');
      if (!trigger) return;

      if (trigger.tagName === 'A') {
        e.preventDefault();
      }
      triggerChatOpen(trigger);
    });
  })();
</script>
