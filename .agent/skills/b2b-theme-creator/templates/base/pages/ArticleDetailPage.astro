---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { ArticleDetail, ArticleCard } from '@/modules/article';

interface Props {
  article: ArticleDetail | null;
  backHref: string;
  backLabel?: string;
  homeHref: string;
  homeLabel?: string;
  listLabel?: string;
  contactHref?: string;
  contactLabel?: string;
  relatedTitle?: string;
  related?: ArticleCard[];
  error?: string;
  warnings?: string[];
}

const {
  article,
  backHref,
  backLabel = '← Back to News',
  homeHref,
  homeLabel = 'Home',
  listLabel = 'News',
  error,
  warnings = [],
} = Astro.props;
---

<PageBanner
  title={article?.title || listLabel}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: listLabel, href: backHref },
    { label: article?.title || listLabel },
  ]}
/>

<section class="__P__-section">
  <div class="__P__-container" style="max-width: 860px">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />

    {article ? (
      <article>
        {article.coverUrl ? (
          <div style="border-radius:var(--radius);overflow:hidden;margin-bottom:2rem;max-height:460px">
            <OptimizedImage src={article.coverUrl} alt={article.title} width={1200} height={600} priority />
          </div>
        ) : null}

        <h1 class="__P__-title" style="margin-bottom: 1.5rem">{article.title}</h1>
        {article.summary ? <p class="__P__-lead" style="margin-bottom: 2rem">{article.summary}</p> : null}

        <div class="__P__-prose" set:html={article.content} />

        <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line)">
          <a class="__P__-btn __P__-btn--outline" href={backHref}>{backLabel}</a>
        </div>
      </article>
    ) : null}
  </div>
</section>
