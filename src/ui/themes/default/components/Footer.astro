---
import type { CompanyView } from '@/modules/company';
import type { NavLink } from '@/modules/nav';

interface Props {
  company: CompanyView;
  links?: NavLink[];
  locale?: string;
  quickLinksLabel?: string;
}
const { company, links = [], locale = 'zh-CN', quickLinksLabel = '快速链接' } = Astro.props;
const year = new Date().getFullYear();

const privacyLabel =
  locale === 'zh-CN'
    ? '隐私权政策'
    : locale === 'zh-TW'
      ? '隱私權政策'
      : locale === 'ja'
        ? 'プライバシーポリシー'
        : 'Privacy Policy';

const termsLabel =
  locale === 'zh-CN'
    ? '服务条款'
    : locale === 'zh-TW'
      ? '服務條款'
      : locale === 'ja'
        ? '利用規約'
        : 'Terms of Service';

const privacyHref = `/${locale}/privacy`;
const termsHref = `/${locale}/terms`;
---
<footer class="cz-footer">
  <div class="cz-container cz-footer-grid">
    <div class="cz-footer-brand">
      <strong style="display:inline-flex;align-items:center;gap:0.5rem">
        {!String(company.logoUrl || '').trim() ? (
          <span class="cz-brand-mark" aria-hidden="true" style="width:28px;height:28px;border-radius:8px">
            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path d="M13 2 4 14h7l-1 8 10-14h-7l0-6z" />
            </svg>
          </span>
        ) : null}
        {company.name}
      </strong>
      {company.slogan ? <p>{company.slogan}</p> : null}
      <div class="cz-footer-meta" style="display:grid;gap:0.35rem;margin-top:0.85rem">
        {company.email ? <a href={`mailto:${company.email}`}>{company.email}</a> : null}
        {company.phone ? <a href={`tel:${company.phone.replace(/\s+/g, '')}`}>{company.phone}</a> : null}
        {company.address ? <span>{company.address}</span> : null}
      </div>
    </div>
    {links.length ? (
      <div class="cz-footer-links">
        <h4>{quickLinksLabel}</h4>
        <ul>
          {links.slice(0, 10).map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    ) : null}
  </div>
  <div class="cz-footer-copy">
    <div class="cz-container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem">
      <span>© {year} {company.name}. All rights reserved.</span>
      <div style="display:inline-flex;align-items:center;gap:1.25rem">
        <a href={privacyHref} style="color:var(--footer-muted);font-size:0.82rem">{privacyLabel}</a>
        <a href={termsHref} style="color:var(--footer-muted);font-size:0.82rem">{termsLabel}</a>
      </div>
    </div>
  </div>
</footer>
