---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { CaseStudyDetail } from '@/modules/case-study';

interface Props {
  item: CaseStudyDetail | null;
  backHref: string;
  backLabel?: string;
  homeHref: string;
  homeLabel?: string;
  listLabel?: string;
  labels?: {
    challenge?: string;
    solution?: string;
    results?: string;
  };
  error?: string;
  warnings?: string[];
}

const {
  item,
  backHref,
  backLabel = '← Back to Cases',
  homeHref,
  homeLabel = 'Home',
  listLabel = 'Cases',
  error,
  warnings = [],
} = Astro.props;
---

<PageBanner
  title={item?.title || listLabel}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: listLabel, href: backHref },
    { label: item?.title || listLabel },
  ]}
/>

<section class="__P__-section">
  <div class="__P__-container" style="max-width: 860px">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />

    {item ? (
      <article>
        {item.coverUrl ? (
          <div style="border-radius:var(--radius);overflow:hidden;margin-bottom:2rem;max-height:460px">
            <OptimizedImage src={item.coverUrl} alt={item.title} width={1200} height={600} priority />
          </div>
        ) : null}

        <h1 class="__P__-title" style="margin-bottom: 1.5rem">{item.title}</h1>
        {item.summary ? <p class="__P__-lead" style="margin-bottom: 2rem">{item.summary}</p> : null}

        <div class="__P__-prose" set:html={item.content} />

        <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line)">
          <a class="__P__-btn __P__-btn--outline" href={backHref}>{backLabel}</a>
        </div>
      </article>
    ) : null}
  </div>
</section>
