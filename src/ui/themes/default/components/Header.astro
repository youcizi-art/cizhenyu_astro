---
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { NavLink } from '@/modules/nav';
import type { CompanyView } from '@/modules/company';

import { t } from '@/modules/i18n';

interface Props {
  siteName: string;
  links: NavLink[];
  localeOptions?: Array<{ code: string; name: string; href: string; active: boolean }>;
  company?: CompanyView;
  contactHref?: string;
  contactLabel?: string;
  homeHref?: string;
  showContactCta?: boolean;
}
const {
  siteName,
  links,
  localeOptions = [],
  company,
  contactHref = '/contact',
  contactLabel: rawContactLabel,
  homeHref = '/',
  showContactCta = true,
} = Astro.props;

const logoUrl = String(company?.logoUrl || '').trim();
const pathname = Astro.url.pathname;
const activeLocale = localeOptions.find((l) => l.active);
const currentLocale = activeLocale?.code || 'en';

const contactLabel = rawContactLabel || t(currentLocale, 'contact');

// 剥离语种前缀（如 /zh-CN, /zh-cn, /en-US, /ja 等），得到纯净路由用于精准比对
function stripLocalePrefix(p: string): string {
  const norm = (p || '').replace(/\/+$/, '') || '/';
  const stripped = norm.replace(/^\/[a-z]{2}(?:-[a-z0-9]{2,4})?(?=\/|$)/i, '') || '/';
  return stripped.toLowerCase();
}

const currentPurePath = stripLocalePrefix(pathname);
const normalizedContactHref = (contactHref || '').replace(/\/+$/, '') || '/';

function isLinkActive(href: string) {
  if (!href) return false;
  if (/^https?:\/\//i.test(href) || href.startsWith('//')) return false;

  const targetPurePath = stripLocalePrefix(href);
  if (targetPurePath === '/') {
    return currentPurePath === '/';
  }
  return currentPurePath === targetPurePath || currentPurePath.startsWith(`${targetPurePath}/`);
}

/**
 * 语言显示名称：完全优先后台接口返回的语言名称
 * 若后台未填或仅为语言代码，使用国际标准 Intl.DisplayNames 自动动态解析该语言的本族自然名称，绝不写死字典
 */
function getLocaleDisplayName(opt: { code: string; name?: string }): string {
  const customName = String(opt.name || '').trim();
  if (customName && customName.toLowerCase() !== opt.code.toLowerCase()) {
    return customName;
  }
  try {
    const dn = new Intl.DisplayNames([opt.code], { type: 'language' });
    const resolved = dn.of(opt.code);
    if (resolved) {
      return resolved.charAt(0).toUpperCase() + resolved.slice(1);
    }
  } catch {}
  return customName || opt.code;
}

// 移动端若已展示底部联系 CTA，则在常规导航链接中过滤联系项，避免出现两个联系方式
const drawerLinks = links.filter((link) => {
  if (!showContactCta) return true;
  return normalizePath(link.href) !== normalizedContactHref;
});
---
<header class="cz-header">
  <div class="cz-container cz-header-inner">
    <a class="cz-brand" href={homeHref} aria-label={siteName}>
      {logoUrl ? (
        <OptimizedImage src={logoUrl} alt={siteName} width={140} height={36} widths={[140, 280]} sizes="140px" priority />
      ) : (
        <>
          <span class="cz-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13 2 4 14h7l-1 8 10-14h-7l0-6z" />
            </svg>
          </span>
          <span>{siteName}</span>
        </>
      )}
    </a>

    <nav class="cz-nav" aria-label="Primary">
      {links.map((link) => {
        const kids = link.children || [];
        const active = isLinkActive(link.href) || kids.some((c) => isLinkActive(c.href));
        if (kids.length) {
          return (
            <details class={`cz-nav-item${active ? ' is-active' : ''}`}>
              <summary class="cz-nav-summary">
                <span>{link.label}</span>
                <svg class="cz-nav-arrow" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="cz-nav-drop">
                {kids.map((child) => {
                  const childActive = isLinkActive(child.href);
                  return (
                    <a href={child.href} class={childActive ? 'is-active' : undefined}>
                      {child.label}
                    </a>
                  );
                })}
              </div>
            </details>
          );
        }
        return (
          <a
            href={link.href}
            class={active ? 'is-active' : undefined}
            target={link.openInNewTab ? '_blank' : undefined}
            rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="cz-header-actions">
      {localeOptions.length > 1 ? (
        <div class="cz-lang">
          <label class="sr-only" for="cz-lang">Language</label>
          <select
            id="cz-lang"
            onchange="if (this.value) location.href=this.value"
            aria-label="Language"
          >
            {localeOptions.map((opt) => (
              <option value={opt.href} selected={opt.active}>{getLocaleDisplayName(opt)}</option>
            ))}
          </select>
        </div>
      ) : null}
      {showContactCta ? (
        <a class="cz-btn cz-btn-primary" href={contactHref} data-cf-chat="open">{contactLabel}</a>
      ) : null}
      <button class="cz-menu-toggle" type="button" aria-label="Menu" data-cz-menu>
        Menu
      </button>
    </div>
  </div>

  <div class="cz-container cz-drawer" data-cz-drawer>
    <div class="cz-drawer-nav">
      {drawerLinks.map((link) => {
        const active = isLinkActive(link.href);
        const rawKids = link.children || [];
        // 去除与父级 label+href 均重复的项
        const kids = rawKids.filter(
          (c) => !(c.label === link.label && normalizePath(c.href) === normalizePath(link.href))
        );

        if (kids.length) {
          const hasActiveChild = kids.some((c) => isLinkActive(c.href));
          return (
            <details class={`cz-drawer-group${active || hasActiveChild ? ' is-active' : ''}`} open={active || hasActiveChild}>
              <summary class="cz-drawer-group-summary">
                <span class="cz-drawer-group-title">{link.label}</span>
                <svg class="cz-drawer-group-arrow" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="cz-drawer-sub-group">
                {kids.map((child) => {
                  const childActive = isLinkActive(child.href);
                  return (
                    <a
                      href={child.href}
                      class={`cz-drawer-sub-link${childActive ? ' is-active' : ''}`}
                    >
                      <span>{child.label}</span>
                    </a>
                  );
                })}
              </div>
            </details>
          );
        }

        return (
          <a
            href={link.href}
            class={`cz-drawer-link${active ? ' is-active' : ''}`}
            target={link.openInNewTab ? '_blank' : undefined}
            rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    {showContactCta ? (
      <div class="cz-drawer-cta">
        <a class="cz-btn cz-btn-primary cz-drawer-cta-btn" href={contactHref} data-cf-chat="open">
          {contactLabel}
        </a>
      </div>
    ) : null}

    {activeLocale ? (
      <div class="cz-drawer-footer">
        <span class="muted">{getLocaleDisplayName(activeLocale)}</span>
      </div>
    ) : null}
  </div>
</header>
<script>
  // 移动端菜单抽屉
  const btn = document.querySelector('[data-cz-menu]');
  const drawer = document.querySelector('[data-cz-drawer]');
  btn?.addEventListener('click', () => drawer?.classList.toggle('is-open'));

  // PC 端鼠标移入有二级菜单的项时自动弹出下拉（移动端保留点击切换）
  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (isFinePointer) {
    const navItems = document.querySelectorAll('.cz-nav .cz-nav-item');
    navItems.forEach((item) => {
      let closeTimer: ReturnType<typeof setTimeout> | null = null;
      item.addEventListener('mouseenter', () => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }
        (item as HTMLDetailsElement).open = true;
      });
      item.addEventListener('mouseleave', () => {
        closeTimer = setTimeout(() => {
          (item as HTMLDetailsElement).open = false;
        }, 150);
      });
    });
  }
</script>
<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
