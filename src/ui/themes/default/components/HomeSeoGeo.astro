---
import type { HomeContent } from "../home-content";

interface Props {
  seoGeo: HomeContent["seoGeo"];
}

const { seoGeo } = Astro.props;
---

<section class="cz-section cz-section-alt cz-home-seo" id="seo-geo">
  <div class="cz-container">
    <div class="cz-section-head cz-section-head-wide">
      <h2>{seoGeo.title}</h2>
      <p class="cz-home-seo-lead"><strong>{seoGeo.lead}</strong></p>
      <p class="cz-home-seo-intro">{seoGeo.intro}</p>
    </div>

    <!-- 站内与站外优化双列网格 -->
    <div class="cz-home-seo-grid">
      <article class="cz-home-seo-column-card">
        <div class="cz-home-seo-col-head">
          <span class="cz-home-seo-tag">ON-SITE</span>
          <h3>{seoGeo.onsite.title}</h3>
        </div>
        <ul class="cz-home-seo-list">
          {
            seoGeo.onsite.items.map((item, idx) => (
              <li>
                <div class="cz-home-seo-num">0{idx + 1}</div>
                <div class="cz-home-seo-info">
                  <strong>{item.title}</strong>
                  <p>{item.desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="cz-home-seo-column-card">
        <div class="cz-home-seo-col-head">
          <span class="cz-home-seo-tag is-alt">OFF-SITE</span>
          <h3>{seoGeo.offsite.title}</h3>
        </div>
        <ul class="cz-home-seo-list">
          {
            seoGeo.offsite.items.map((item, idx) => (
              <li>
                <div class="cz-home-seo-num">0{idx + 1}</div>
                <div class="cz-home-seo-info">
                  <strong>{item.title}</strong>
                  <p>{item.desc}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <!-- 你真正得到的是什么？ -->
    <div class="cz-home-seo-value-box">
      <div class="cz-home-seo-value-head">
        <h3>{seoGeo.value.title}</h3>
        <p class="cz-home-seo-value-lead">
          <strong>{seoGeo.value.lead}</strong>
        </p>
      </div>
      <div class="cz-home-seo-value-grid">
        {
          seoGeo.value.items.map((item) => (
            <div class="cz-home-seo-value-item">
              <svg
                class="cz-check-icon"
                viewBox="0 0 20 20"
                fill="currentColor"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <div>
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 工作流推进与呼出客服按钮 -->
    <div class="cz-home-seo-workflow-panel">
      <div class="cz-home-seo-workflow-copy">
        <h3>{seoGeo.workflow.title}</h3>
        <p class="cz-home-seo-wf-lead">{seoGeo.workflow.lead}</p>
        <p class="cz-home-seo-wf-note">{seoGeo.workflow.desc}</p>
      </div>
      <div class="cz-home-seo-workflow-action">
        <button
          type="button"
          class="cz-btn cz-btn-primary cz-btn-lg"
          data-cf-chat="open"
          data-product-title={seoGeo.workflow.cta}
        >
          <span>{seoGeo.workflow.cta}</span>
          <svg
            class="cz-btn-arrow"
            viewBox="0 0 20 20"
            fill="currentColor"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
