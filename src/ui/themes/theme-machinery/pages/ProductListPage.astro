---
import PageBanner from '../components/PageBanner.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Alerts from '../components/Alerts.astro';
import type { ProductCard } from '@/modules/product';
import type { PublicPages } from '@/modules/cms';

interface Props {
  title: string;
  items: ProductCard[];
  pages: PublicPages;
  basePath: string;
  emptyText?: string;
  readMoreText?: string;
  homeHref?: string;
  homeLabel?: string;
  categoryLinks?: Array<{ title: string; href: string }>;
  error?: string;
  warnings?: string[];
}
const {
  title,
  items,
  pages,
  basePath,
  emptyText = 'No products yet.',
  readMoreText = 'Learn More',
  homeHref = '/',
  homeLabel = 'Home',
  categoryLinks = [],
  error,
  warnings = [],
} = Astro.props;

const totalPages = Math.max(1, pages.totalPages || 1);
const page = Math.max(1, pages.page || 1);
const prevHref = page > 1 ? `${basePath}?page=${page - 1}` : '';
const nextHref = page < totalPages ? `${basePath}?page=${page + 1}` : '';
---
<PageBanner
  title={title}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: title },
  ]}
/>
<section class="tm-section tm-section-white">
  <div class="tm-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
    {categoryLinks.length ? (
      <p class="tm-prose">
        {categoryLinks.map((item, idx) => (
          <>
            {idx > 0 ? ' · ' : null}
            <a class="tm-link-more" href={item.href}>{item.title}</a>
          </>
        ))}
      </p>
    ) : null}
    {!error && !items.length ? <p class="tm-prose">{emptyText}</p> : null}
  </div>
  <ProductGrid title="" items={items} readMoreText={readMoreText} variant="list" />
  {!error && totalPages > 1 ? (
    <div class="tm-container tm-pager">
      {prevHref ? <a class="tm-link-more" href={prevHref}>← Prev</a> : null}
      <span class="tm-prose" style="margin:0">Page {page} / {totalPages}</span>
      {nextHref ? <a class="tm-link-more" href={nextHref}>Next →</a> : null}
    </div>
  ) : null}
</section>
