---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { CaseStudyDetail } from '@/modules/case-study';

interface Props {
  item: CaseStudyDetail | null;
  backHref: string;
  backLabel?: string;
  homeHref: string;
  homeLabel?: string;
  listLabel?: string;
  labels?: {
    challenge?: string;
    solution?: string;
    results?: string;
  };
  error?: string;
  warnings?: string[];
}
const {
  item,
  backHref,
  backLabel = '← Back to list',
  homeHref,
  homeLabel = 'Home',
  listLabel = 'Case Studies',
  labels = {},
  error,
  warnings = [],
} = Astro.props;
---
<PageBanner
  title={item?.title || listLabel}
  summary={item?.summary}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: listLabel, href: backHref },
    { label: item?.title || listLabel },
  ]}
/>
<section class="tm-section tm-section-white">
  <div class="tm-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
    {item ? (
      <div class="tm-case-detail">
        {(item.clientName || item.industry) ? (
          <p class="tm-case-meta">{[item.clientName, item.industry].filter(Boolean).join(' · ')}</p>
        ) : null}
        {item.coverUrl ? (
          <div class="tm-case-hero-img">
            <OptimizedImage
              src={item.coverUrl}
              alt={item.title}
              width={1200}
              height={640}
              widths={[640, 960, 1200]}
              sizes="(max-width: 900px) 100vw, 900px"
              priority
            />
          </div>
        ) : null}
        {item.challenge ? (
          <section class="tm-case-block">
            <h2 class="tm-display">{labels.challenge || 'Challenge'}</h2>
            <div class="tm-prose" set:html={item.challenge} />
          </section>
        ) : null}
        {item.solution ? (
          <section class="tm-case-block">
            <h2 class="tm-display">{labels.solution || 'Solution'}</h2>
            <div class="tm-prose" set:html={item.solution} />
          </section>
        ) : null}
        {item.results ? (
          <section class="tm-case-block">
            <h2 class="tm-display">{labels.results || 'Results'}</h2>
            <div class="tm-prose" set:html={item.results} />
          </section>
        ) : null}
        {item.content ? (
          <section class="tm-case-block">
            <div class="tm-prose" set:html={item.content} />
          </section>
        ) : null}
        <p style="margin-top:2rem">
          <a class="tm-btn tm-btn-md tm-btn-primary-line" href={backHref}>{backLabel}</a>
        </p>
      </div>
    ) : null}
  </div>
</section>
