---
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import { getThemeMeta } from './theme-ui';
import { t } from '@/modules/i18n';
import type { PageChrome } from '@/workflows/chrome/load-chrome';

interface Props {
  chrome: PageChrome;
  kind: 'about' | 'contact' | 'faq' | 'page' | 'privacy' | 'terms';
  title: string;
  summary?: string;
  content?: string;
  references?: any[];
  faqItems?: Array<{ question: string; answer: string; shortAnswer?: string }>;
  emptyHint?: string;
  error?: string;
}
const {
  chrome,
  kind,
  title,
  summary = '',
  content = '',
  references = [],
  faqItems = [],
  emptyHint = '',
  error,
} = Astro.props;
const meta = getThemeMeta(chrome.site.theme);
const homeHref = `/${chrome.locale}`;
const homeLabel = t(chrome.locale, 'home');
const relatedTitle = chrome.locale.startsWith('zh') ? '相关内容' : 'Related';
const shortAnswerLabel = chrome.locale.startsWith('zh') ? '简答' : chrome.locale === 'ja' ? '簡潔な回答' : 'Short answer';

const aboutModules = import.meta.glob<{ default: any }>('./*/pages/AboutPage.astro', { eager: true });
const contactModules = import.meta.glob<{ default: any }>('./*/pages/ContactPage.astro', { eager: true });
const faqModules = import.meta.glob<{ default: any }>('./*/pages/FaqPage.astro', { eager: true });
const simpleDetailModules = import.meta.glob<{ default: any }>('./*/pages/SimpleDetailPage.astro', { eager: true });

const TargetAbout = aboutModules[`./${meta.id}/pages/AboutPage.astro`]?.default;
const TargetContact = contactModules[`./${meta.id}/pages/ContactPage.astro`]?.default;
const TargetFaq = faqModules[`./${meta.id}/pages/FaqPage.astro`]?.default;
const TargetSimpleDetail = simpleDetailModules[`./${meta.id}/pages/SimpleDetailPage.astro`]?.default;
---
{kind === 'about' && TargetAbout ? (
  <TargetAbout
    title={title}
    summary={summary}
    content={content}
    company={chrome.company}
    references={references}
    relatedTitle={relatedTitle}
    homeHref={homeHref}
    homeLabel={homeLabel}
    error={error}
    warnings={chrome.warnings}
    emptyHint={emptyHint}
  />
) : kind === 'contact' && TargetContact ? (
  <TargetContact
    title={title}
    content={content}
    company={chrome.company}
    homeHref={homeHref}
    homeLabel={homeLabel}
    error={error}
    warnings={chrome.warnings}
    emptyHint={emptyHint}
    inquiryLabel={t(chrome.locale, 'inquiry')}
    inquiryHint={t(chrome.locale, 'inquiryHint')}
    mailLabel={t(chrome.locale, 'sendEmail')}
  />
) : kind === 'faq' && TargetFaq ? (
  <TargetFaq
    title={title}
    items={faqItems}
    homeHref={homeHref}
    homeLabel={homeLabel}
    shortAnswerLabel={shortAnswerLabel}
    emptyText={emptyHint || (chrome.locale.startsWith('zh') ? '暂无 FAQ。' : 'No FAQs yet.')}
    error={error}
    warnings={chrome.warnings}
  />
) : kind === 'faq' ? (
  <>
    <h1>{title}</h1>
    <AlertBanner messages={error ? [error] : []} />
    {faqItems.map((item) => (
      <details class="faq-item card">
        <summary>{item.question}</summary>
        <div class="prose" set:html={item.answer} />
      </details>
    ))}
  </>
) : (kind === 'page' || kind === 'privacy' || kind === 'terms') && TargetSimpleDetail ? (
  <TargetSimpleDetail
    title={title}
    summary={summary}
    content={content}
    backHref={homeHref}
    backLabel={`← ${homeLabel}`}
    homeHref={homeHref}
    homeLabel={homeLabel}
    listLabel={homeLabel}
    error={error}
    warnings={chrome.warnings}
  />
) : (
  <>
    <AlertBanner messages={error ? [error] : []} />
    <h1>{title}</h1>
    {content ? <div class="prose" set:html={content} /> : null}
  </>
)}
