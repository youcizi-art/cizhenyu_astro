---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import ThemeFrame from '@/ui/themes/ThemeFrame.astro';
import ActiveCardList from '@/ui/themes/ActiveCardList.astro';
import { loadCaseStudyListPage } from '@/workflows/case-studies/load-case-study-list';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { buildAlternateLinks } from '@/workflows/chrome/urls';
import { resolveListPageSeo } from '@/modules/seo';
import { t } from '@/modules/i18n';

export const prerender = false;

const page = Number(Astro.url.searchParams.get('page') || 1) || 1;
const data = await loadCaseStudyListPage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
  page,
});
if (!data.localeValid) return Astro.redirect(`/${data.site.defaultLocale}/case-studies`, 302);
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled) return Astro.rewrite('/404');
const fallbackTitle = t(data.locale, 'caseStudies');
const listSeo = await resolveListPageSeo({
  slug: 'case-studies',
  locale: data.locale,
  pathname: Astro.url.pathname,
  fallbackTitle,
  fallbackDescription: data.company.summary,
  siteName: data.siteName,
  company: {
    name: data.company.name,
    address: data.company.address,
    country: data.company.country,
    phone: data.company.phone,
    email: data.company.email,
    website: data.company.website,
    logoUrl: data.company.logoUrl,
    foundingDate: data.company.foundingDate,
    sameAs: data.company.sameAs,
  },
  breadcrumbs: [
    { name: t(data.locale, 'home'), href: `/${data.locale}` },
    { name: fallbackTitle },
  ],
});
---
<BaseLayout
  title={`${listSeo.title} · ${data.siteName}`}
  description={listSeo.description}
  lang={data.locale}
  siteName={data.siteName}
  alternates={buildAlternateLinks(data.localeOptions, { defaultLocale: data.site.defaultLocale })}
  {...listSeo.seoProps}
  jsonLd={listSeo.jsonLd}
>
  <ThemeFrame chrome={data}>
    <ActiveCardList
      chrome={data}
      kind="caseStudies"
      title={fallbackTitle}
      items={data.items}
      pages={data.pages}
      basePath={`/${data.locale}/case-studies`}
      emptyText={data.locale.startsWith('zh') ? '暂无案例。' : 'No case studies yet.'}
      error={data.error}
    />
  </ThemeFrame>
</BaseLayout>
