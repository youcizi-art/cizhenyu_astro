---
import type { NavLink } from '@/modules/nav';
import type { CompanyView } from '@/modules/company';
import { localePath } from '@/modules/cms';
import { t } from '@/modules/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  siteName: string;
  links: NavLink[];
  localeOptions?: Array<{ code: string; name: string; href: string; active: boolean }>;
  languageLabel?: string;
  company?: CompanyView;
  locale?: string;
  showContactCta?: boolean;
}
const {
  siteName,
  links,
  localeOptions = [],
  languageLabel = 'Language',
  company,
  locale = '',
  showContactCta = true,
} = Astro.props;

const homeHref = links[0]?.href || (locale ? localePath(locale, '/') : '/');
const contactHref = locale ? localePath(locale, '/contact') : '/contact';
const contactLabel = t(locale || 'en', 'contact');
const email = String(company?.email || '').trim();
const phone = String(company?.phone || '').trim();
const showTopbar = Boolean(email || phone);
---
{showTopbar ? (
  <div class="site-topbar">
    <div class="wrap">
      <div class="topbar-contacts">
        {email ? <a href={`mailto:${email}`}>{email}</a> : null}
        {phone ? <a href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a> : null}
      </div>
    </div>
  </div>
) : null}
<header class="site">
  <div class="wrap">
    <strong class="brand-mark"><a href={homeHref}>{siteName}</a></strong>
    <div class="header-right">
      <nav class="site-nav">
        {links.map((link) => (
          link.children?.length ? (
            <div class="nav-item has-dropdown">
              <a href={link.href} target={link.openInNewTab ? '_blank' : undefined} rel={link.openInNewTab ? 'noopener noreferrer' : undefined}>
                {link.label}
              </a>
              <div class="nav-dropdown" role="menu">
                {link.children.map((child) => (
                  <a class="nav-dropdown-item" href={child.href} role="menuitem">
                    {child.coverUrl ? <img src={child.coverUrl} alt="" loading="lazy" /> : null}
                    <span>
                      <strong>{child.label}</strong>
                      {child.summary ? <small>{child.summary}</small> : null}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href} target={link.openInNewTab ? '_blank' : undefined} rel={link.openInNewTab ? 'noopener noreferrer' : undefined}>
              {link.label}
            </a>
          )
        ))}
      </nav>
      <LanguageSwitcher options={localeOptions} label={languageLabel} />
      {showContactCta ? (
        <a class="header-cta" href={contactHref}>{contactLabel}</a>
      ) : null}
    </div>
  </div>
</header>
