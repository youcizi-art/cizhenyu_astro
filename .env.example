PUBLIC_CMS_API_BASE=http://127.0.0.1:5173
PUBLIC_CMS_API_PREFIX=/api/p
PUBLIC_MEDIA_BASE=
PUBLIC_SITE_URL=http://localhost:4321
# 客户站皮肤：turmill（绿系）| demo（蓝系默认主题）
SITE_KEY=turmill
REVALIDATE_SECRET=dev-revalidate-secret

# 可选：回退本地 Mock CMS
# PUBLIC_CMS_API_BASE=http://127.0.0.1:8787

# 可选：开发环境强制开启 HTML 缓存（默认 DEV 关闭，避免 CMS 改完页面仍旧）
# HTML_CACHE_IN_DEV=1
# DISABLE_HTML_CACHE=1

# 可选：生产 CDN 真实 purge（阶段 D）
# CF_ZONE_ID=
# CF_API_TOKEN=

# ---------- 生产 revalidate（与 CMS SITE_REVALIDATE_* 对齐）----------
# 1) Pages 环境变量：
#    REVALIDATE_SECRET=<与 CMS 相同的随机串>
#    PUBLIC_SITE_URL=https://www.turmill.com
#    SITE_KEY=turmill
# 2) CMS Worker（wrangler production / Dashboard）：
#    SITE_REVALIDATE_URL=https://www.turmill.com/api/revalidate
#    SITE_REVALIDATE_SECRET=<同上>
#    SITE_REVALIDATE_SITE_KEY=turmill
# 校验：后台改内容后 GET /api/revalidate 可见 lastPurge；或页面 X-HTML-Cache 从 HIT→MISS
# 详见 docs/CACHE_STRATEGY.md

# 联调说明：
# - 默认对接本地 cizhenyu_payload（npm run dev → :5173）
# - site.manifest.locales 须与 CMS /api/p/languages 对齐（zh-CN / zh-TW / ja / en-US）
# - 导航优先 CMS；失败时回退 manifest 并在页面 warning 提示
# - 回退 Mock：改 PUBLIC_CMS_API_BASE=http://127.0.0.1:8787 并 npm run mock:cms
# - 切回蓝皮肤对照：SITE_KEY=demo
