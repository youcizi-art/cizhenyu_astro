---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import SiteHeader from '@/ui/layout/SiteHeader.astro';
import SiteFooter from '@/ui/layout/SiteFooter.astro';
import { loadCaseStudyDetailPage } from '@/workflows/case-studies/load-case-study-detail';
import { loadSiteManifest } from '@/modules/site';
import { applyCacheHeaders, resolveLocaleParam } from '@/workflows/chrome/http';

export const prerender = false;

const site = loadSiteManifest();
const locale = resolveLocaleParam(site.locales, site.defaultLocale, Astro.params.locale);
const id = String(Astro.params.id || '').trim();
const data = await loadCaseStudyDetailPage({ locale, id });
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled || !data.item) return new Response('Not Found', { status: 404 });
const item = data.item;
---
<BaseLayout title={`${item.title} · ${data.siteName}`} description={item.summary}>
  <SiteHeader siteName={data.siteName} links={data.navLinks} />
  <main class="wrap">
    <p><a href={`/${locale}/case-studies`}>← Case Studies</a></p>
    <h1>{item.title}</h1>
    {(item.clientName || item.industry) ? (
      <p class="muted">{[item.clientName, item.industry].filter(Boolean).join(' · ')}</p>
    ) : null}
    {item.summary ? <p>{item.summary}</p> : null}
    {item.challenge ? <section class="section"><h2>Challenge</h2><div class="prose" set:html={item.challenge} /></section> : null}
    {item.solution ? <section class="section"><h2>Solution</h2><div class="prose" set:html={item.solution} /></section> : null}
    {item.results ? <section class="section"><h2>Results</h2><div class="prose" set:html={item.results} /></section> : null}
    {item.content ? <section class="section"><div class="prose" set:html={item.content} /></section> : null}
  </main>
  <SiteFooter company={data.company} />
</BaseLayout>
