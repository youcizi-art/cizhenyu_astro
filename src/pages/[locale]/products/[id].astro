---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import SiteHeader from '@/ui/layout/SiteHeader.astro';
import SiteFooter from '@/ui/layout/SiteFooter.astro';
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import { loadProductDetailPage } from '@/workflows/products/load-product-detail';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { buildAlternateLinks } from '@/workflows/chrome/urls';
import { layoutSeoProps, pageJsonLd } from '@/modules/seo';

export const prerender = false;

const id = String(Astro.params.id || '').trim();
const data = await loadProductDetailPage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
  id,
});
if (!data.localeValid) {
  return Astro.redirect(`/${data.site.defaultLocale}/products`, 302);
}
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled) return Astro.rewrite('/404');
if (!data.error && !data.product) return Astro.rewrite('/404');
const product = data.product;
const title = product ? `${product.seoTitle} · ${data.siteName}` : `Product · ${data.siteName}`;
const seoProps = layoutSeoProps(product?.seo, Astro.url.pathname);
const jsonLd = product
  ? pageJsonLd(product.seo, Astro.url.pathname, {
      siteName: data.siteName,
      company: data.company,
      product: {
        name: product.title,
        description: product.summary || product.seoDescription,
        sku: product.sku,
        brand: product.brand,
        imageUrls: product.imageUrls,
      },
    })
  : null;
---
<BaseLayout
  title={title}
  description={product?.seoDescription || ''}
  lang={data.locale}
  alternates={buildAlternateLinks(data.localeOptions, { defaultLocale: data.site.defaultLocale })}
  {...seoProps}
  jsonLd={jsonLd}
>
  <SiteHeader
    siteName={data.siteName}
    links={data.navLinks}
    localeOptions={data.localeOptions}
    languageLabel={data.languageLabel}
  />
  <main class="wrap">
    <p><a href={`/${data.locale}/products`}>← Products</a></p>
    <AlertBanner messages={data.error ? [data.error] : []} />
    <AlertBanner messages={data.warnings} tone="warn" />
    {product ? (
      <article>
        <h1>{product.title}</h1>
        {product.sku ? <p class="muted">SKU: {product.sku}</p> : null}
        {product.brand ? <p class="muted">{product.brand}</p> : null}
        {product.coverUrl ? (
          <p><img class="card-media" src={product.coverUrl} alt={product.title} /></p>
        ) : null}
        {product.imageUrls?.length > 1 ? (
          <div class="gallery">
            {product.imageUrls.map((src) => (
              <img src={src} alt={product.title} loading="lazy" />
            ))}
          </div>
        ) : null}
        {product.summary ? <p>{product.summary}</p> : null}
        {product.descriptionHtml ? <div class="prose" set:html={product.descriptionHtml} /> : null}
        {product.specs?.length ? (
          <section class="section">
            <h2>规格</h2>
            <table class="specs">
              <tbody>
                {product.specs.map((row) => (
                  <tr>
                    <th>{row.key}</th>
                    <td>{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        ) : null}
        {(product.price || product.availability) ? (
          <p class="muted">
            {product.price ? `${product.currency} ${product.price}` : ''}
            {product.availability ? ` · ${product.availability}` : ''}
          </p>
        ) : null}
      </article>
    ) : null}
  </main>
  <SiteFooter company={data.company} />
</BaseLayout>
