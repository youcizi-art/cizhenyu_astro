---
/**
 * 通用列表页主题切换（文章/案例/方案/资料）
 */
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import Pagination from '@/ui/blocks/Pagination.astro';
import { getThemeMeta } from './theme-ui';
import { t } from '@/modules/i18n';
import type { PublicPages } from '@/modules/cms';
import type { PageChrome } from '@/workflows/chrome/load-chrome';

type CardItem = {
  title: string;
  href: string;
  summary?: string;
  coverUrl?: string;
  meta?: string;
  author?: string;
  industry?: string;
  clientName?: string;
};

interface Props {
  chrome: PageChrome;
  kind: 'articles' | 'caseStudies' | 'solutions' | 'resources';
  title: string;
  items: CardItem[];
  pages: PublicPages;
  basePath: string;
  emptyText: string;
  typeLinks?: Array<{ title: string; href: string }>;
  error?: string;
}
const { chrome, kind, title, items, pages, basePath, emptyText, typeLinks = [], error } = Astro.props;
const meta = getThemeMeta(chrome.site.theme);
const homeHref = `/${chrome.locale}`;
const homeLabel = t(chrome.locale, 'home');
const readMore = chrome.locale.startsWith('zh') ? '了解更多' : 'Learn More';

const articleListModules = import.meta.glob<{ default: any }>('./*/pages/ArticleListPage.astro', { eager: true });
const caseStudyListModules = import.meta.glob<{ default: any }>('./*/pages/CaseStudyListPage.astro', { eager: true });
const downloadListModules = import.meta.glob<{ default: any }>('./*/pages/DownloadListPage.astro', { eager: true });
const simpleCardListModules = import.meta.glob<{ default: any }>('./*/pages/SimpleCardListPage.astro', { eager: true });

const TargetArticleList = articleListModules[`./${meta.id}/pages/ArticleListPage.astro`]?.default || articleListModules['./default/pages/ArticleListPage.astro']?.default;
const TargetCaseStudyList = caseStudyListModules[`./${meta.id}/pages/CaseStudyListPage.astro`]?.default || caseStudyListModules['./default/pages/CaseStudyListPage.astro']?.default;
const TargetDownloadList = downloadListModules[`./${meta.id}/pages/DownloadListPage.astro`]?.default;
const TargetSimpleCardList = simpleCardListModules[`./${meta.id}/pages/SimpleCardListPage.astro`]?.default || simpleCardListModules['./default/pages/SimpleCardListPage.astro']?.default;
---
{kind === 'articles' && TargetArticleList ? (
  <TargetArticleList
    title={title}
    items={items as any}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    readMoreText={chrome.locale.startsWith('zh') ? '阅读更多' : 'Read More'}
    typeLinks={typeLinks}
    error={error}
    warnings={chrome.warnings}
  />
) : kind === 'caseStudies' && TargetCaseStudyList ? (
  <TargetCaseStudyList
    title={title}
    items={items as any}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    error={error}
    warnings={chrome.warnings}
  />
) : kind === 'resources' && TargetDownloadList ? (
  <TargetDownloadList
    title={title}
    items={items.map((item) => ({
      ...item,
      inquiryHref: `${homeHref}/contact?intent=download&from=${encodeURIComponent(item.href)}`,
    }))}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    lead={
      chrome.locale.startsWith('zh')
        ? '下载安装包将进入询盘；客服可协作完成安装与初始化。正式安装包通过询盘交付。'
        : 'Download opens inquiry — we can collaborate on install. Packages are delivered after inquiry.'
    }
    downloadLabel={chrome.locale.startsWith('zh') ? '下载 / 询盘' : 'Download / Inquire'}
    error={error}
    warnings={chrome.warnings}
  />
) : TargetSimpleCardList ? (
  <TargetSimpleCardList
    title={title}
    items={items}
    pages={pages}
    basePath={basePath}
    homeHref={homeHref}
    homeLabel={homeLabel}
    emptyText={emptyText}
    readMoreText={readMore}
    error={error}
    warnings={chrome.warnings}
  />
) : (
  <>
    <h1>{title}</h1>
    <AlertBanner messages={error ? [error] : []} />
    <AlertBanner messages={chrome.warnings} tone="warn" />
    <div class="card-list">
      {items.map((item) => (
        <article class="card">
          {item.coverUrl ? <img class="card-media" src={item.coverUrl} alt={item.title} loading="lazy" /> : null}
          <h2><a href={item.href}>{item.title}</a></h2>
          {item.summary ? <p>{item.summary}</p> : null}
        </article>
      ))}
    </div>
    {!error && !items.length ? <p class="muted">{emptyText}</p> : null}
    {!error ? <Pagination pages={pages} basePath={basePath} /> : null}
  </>
)}
