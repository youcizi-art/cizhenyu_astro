---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import type { CompanyView } from '@/modules/company';
import type { ResolvedReferenceCard } from '@/modules/reference';

interface Props {
  title: string;
  summary?: string;
  content?: string;
  company: CompanyView;
  references?: ResolvedReferenceCard[];
  relatedTitle?: string;
  homeHref?: string;
  homeLabel?: string;
  error?: string;
  warnings?: string[];
  emptyHint?: string;
}
const {
  title,
  summary = '',
  content = '',
  company,
  references = [],
  relatedTitle = 'Related',
  homeHref = '/',
  homeLabel = 'Home',
  error,
  warnings = [],
  emptyHint = '',
} = Astro.props;
---
<PageBanner
  title={title}
  summary={summary || company.slogan}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: title },
  ]}
/>
<section class="tm-section tm-section-white">
  <div class="tm-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
    <div class="tm-about-grid">
      <div class="tm-about-copy">
        {company.summary ? <p class="tm-prose">{company.summary}</p> : null}
        {content ? <div class="tm-prose" set:html={content} /> : null}
        {!content && !company.summary && emptyHint ? <p class="tm-prose">{emptyHint}</p> : null}
      </div>
      <aside class="tm-about-panel">
        {company.logoUrl ? <img src={company.logoUrl} alt={company.name} /> : null}
        <strong style="display:block;font-family:var(--font-display);font-size:1.25rem;color:#1f2b23">{company.name}</strong>
        {company.slogan ? <p style="margin:0.5rem 0 0;color:#55665b;font-size:0.95rem">{company.slogan}</p> : null}
        <div class="tm-footer-meta" style="margin-top:1rem">
          {company.address ? <span>{company.address}</span> : null}
          {company.phone ? <a href={`tel:${company.phone.replace(/\s+/g, '')}`}>{company.phone}</a> : null}
          {company.email ? <a href={`mailto:${company.email}`}>{company.email}</a> : null}
          {company.website ? <a href={company.website}>{company.website}</a> : null}
        </div>
      </aside>
    </div>
    {references.length ? (
      <section style="margin-top:3rem">
        <div class="tm-title-wrap">
          <h2 class="tm-title-main">{relatedTitle}</h2>
        </div>
        <div class="tm-grid-3">
          {references.map((item) => (
            <article class="tm-product-card tm-card-hover">
              <a
                class="tm-product-cover tm-img-cover"
                href={item.href}
                style={item.coverUrl ? `background-image:url(${item.coverUrl})` : undefined}
                aria-label={item.title}
              />
              <div class="tm-product-body">
                <h3><a href={item.href}>{item.title}</a></h3>
                {item.description || item.subtitle ? <p>{item.description || item.subtitle}</p> : null}
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : null}
  </div>
</section>
