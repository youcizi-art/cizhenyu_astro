---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import ThemeFrame from '@/ui/themes/ThemeFrame.astro';
import ActiveHome from '@/ui/themes/ActiveHome.astro';
import { loadHomePage } from '@/workflows/home/load-home';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { buildAlternateLinks } from '@/workflows/chrome/urls';
import { layoutSeoProps, pageJsonLd, siteOrigin } from '@/modules/seo';
import { t, defaultLocaleHref } from '@/modules/i18n';

export const prerender = false;

const data = await loadHomePage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
});
if (!data.localeValid) {
  return Astro.redirect(defaultLocaleHref("/"), 302);
}
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
const origin = siteOrigin() || Astro.url.origin;
const cmsPage = data.cmsPage;
const fallbackDescription = data.tagline || data.companyIntro || data.company.summary || '';
const title = cmsPage?.seoTitle || cmsPage?.title || data.siteName;
const description = cmsPage?.seoDescription || cmsPage?.summary || fallbackDescription;
const seo = cmsPage?.seo || {
  title,
  description,
  canonicalUrl: Astro.url.pathname,
  robots: 'index,follow',
  ogImage: data.hero?.imageUrl || data.heroImageUrl || data.company.logoUrl || '',
  ogType: 'website',
  schemaType: 'WebSite',
  schemaMapping: '',
  geoLat: data.company.geoLat || '',
  geoLng: data.company.geoLng || '',
};
const seoProps = layoutSeoProps(
  { ...seo, schemaType: seo.schemaType || 'WebSite', ogImage: seo.ogImage || data.hero?.imageUrl || data.company.logoUrl || '' },
  Astro.url.pathname
);
const jsonLd = pageJsonLd(
  {
    ...seo,
    schemaType: 'WebSite',
    title: seo.title || title,
    description: seo.description || description,
    ogImage: seo.ogImage || data.hero?.imageUrl || data.company.logoUrl || '',
    geoLat: seo.geoLat || data.company.geoLat || '',
    geoLng: seo.geoLng || data.company.geoLng || '',
  },
  Astro.url.pathname,
  {
    siteName: data.siteName,
    company: data.company,
    breadcrumbs: [{ name: t(data.locale, 'home') }],
  }
);
const alternates = buildAlternateLinks(data.localeOptions, {
  defaultLocale: data.site.defaultLocale,
  origin,
});
const pageTitle = title.includes(data.siteName) ? title : `${title} · ${data.siteName}`;
---
<BaseLayout
  title={pageTitle}
  description={description}
  lang={data.locale}
  siteName={data.siteName}
  alternates={alternates}
  {...seoProps}
  jsonLd={jsonLd}
>
  <ThemeFrame chrome={data}>
    <ActiveHome data={data} />
  </ThemeFrame>
</BaseLayout>
