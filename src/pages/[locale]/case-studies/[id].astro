---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import SiteHeader from '@/ui/layout/SiteHeader.astro';
import SiteFooter from '@/ui/layout/SiteFooter.astro';
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import { loadCaseStudyDetailPage } from '@/workflows/case-studies/load-case-study-detail';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { buildAlternateLinks } from '@/workflows/chrome/urls';
import { t } from '@/modules/i18n';

export const prerender = false;

const id = String(Astro.params.id || '').trim();
const data = await loadCaseStudyDetailPage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
  id,
});
if (!data.localeValid) return Astro.redirect(`/${data.site.defaultLocale}/case-studies`, 302);
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled) return new Response('Not Found', { status: 404 });
if (!data.error && !data.item) return new Response('Not Found', { status: 404 });
const item = data.item;
---
<BaseLayout
  title={`${item?.seoTitle || item?.title || t(data.locale, 'caseStudies')} · ${data.siteName}`}
  description={item?.seoDescription || item?.summary || ''}
  lang={data.locale}
  alternates={buildAlternateLinks(data.localeOptions)}
>
  <SiteHeader siteName={data.siteName} links={data.navLinks} localeOptions={data.localeOptions} languageLabel={data.languageLabel} />
  <main class="wrap">
    <p><a href={`/${data.locale}/case-studies`}>← {t(data.locale, 'caseStudies')}</a></p>
    <AlertBanner messages={data.error ? [data.error] : []} />
    <AlertBanner messages={data.warnings} tone="warn" />
    {item ? (
      <>
        <h1>{item.title}</h1>
        {(item.clientName || item.industry) ? (
          <p class="muted">{[item.clientName, item.industry].filter(Boolean).join(' · ')}</p>
        ) : null}
        {item.coverUrl ? <p><img class="card-media" src={item.coverUrl} alt={item.title} /></p> : null}
        {item.summary ? <p>{item.summary}</p> : null}
        {item.challenge ? <section class="section"><h2>Challenge</h2><div class="prose" set:html={item.challenge} /></section> : null}
        {item.solution ? <section class="section"><h2>Solution</h2><div class="prose" set:html={item.solution} /></section> : null}
        {item.results ? <section class="section"><h2>Results</h2><div class="prose" set:html={item.results} /></section> : null}
        {item.content ? <section class="section"><div class="prose" set:html={item.content} /></section> : null}
      </>
    ) : null}
  </main>
  <SiteFooter company={data.company} />
</BaseLayout>
