---
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { NavLink } from '@/modules/nav';
import type { CompanyView } from '@/modules/company';

interface Props {
  siteName: string;
  links: NavLink[];
  localeOptions?: Array<{ code: string; name: string; href: string; active: boolean }>;
  company?: CompanyView;
  contactHref?: string;
  contactLabel?: string;
  homeHref?: string;
  showContactCta?: boolean;
}

const {
  siteName,
  links,
  localeOptions = [],
  company,
  contactHref = '/contact',
  contactLabel = 'Contact Us',
  homeHref = '/',
  showContactCta = true,
} = Astro.props;

const logoUrl = String(company?.logoUrl || '').trim();
const pathname = Astro.url.pathname;
const activeLocale = localeOptions.find((l) => l.active);
---

<header class="nrg-header">
  <div class="nrg-container nrg-header-inner">
    <a class="nrg-brand" href={homeHref} aria-label={siteName}>
      {logoUrl ? (
        <OptimizedImage src={logoUrl} alt={siteName} width={160} height={40} priority />
      ) : (
        <>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12A10 10 0 0 1 12 2z"/>
            <path d="M12 6v6l4 2"/>
          </svg>
          <span>{siteName}</span>
        </>
      )}
    </a>

    <nav class="nrg-nav" aria-label="Primary">
      {links.map((link) => {
        const active = pathname === link.href || (link.href !== '/' && pathname.startsWith(`${link.href}/`));
        return (
          <div class="nrg-nav-item">
            <a
              href={link.href}
              class={active ? 'is-active' : undefined}
              target={link.openInNewTab ? '_blank' : undefined}
              rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
            >
              {link.label}
              {link.children?.length ? <span aria-hidden="true" style="font-size: 0.75em; opacity: 0.7">▾</span> : null}
            </a>
            {link.children?.length ? (
              <div class="nrg-nav-drop">
                <ul>
                  {link.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </div>
            ) : null}
          </div>
        );
      })}
    </nav>

    <div class="nrg-header-actions">
      {localeOptions.length > 1 ? (
        <div class="nrg-nav-item">
          <a href="#">{activeLocale?.name || 'Language'} ▾</a>
          <div class="nrg-nav-drop">
            <ul>
              {localeOptions.map((opt) => (
                <li><a href={opt.href}>{opt.name}</a></li>
              ))}
            </ul>
          </div>
        </div>
      ) : null}

      {showContactCta ? (
        <a class="nrg-btn nrg-btn--primary nrg-btn--sm" href={contactHref}>
          {contactLabel}
        </a>
      ) : null}

      <button type="button" class="nrg-menu-toggle" id="nrg-menu-toggle" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="nrg-drawer" id="nrg-drawer">
    {links.map((link) => (
      <div>
        <a href={link.href}>{link.label}</a>
        {link.children?.map((child) => (
          <a href={child.href} style="padding-left:1.25rem;font-size:0.9rem;opacity:0.8">{child.label}</a>
        ))}
      </div>
    ))}
    {showContactCta ? (
      <div style="margin-top:1.25rem">
        <a class="nrg-btn nrg-btn--primary" href={contactHref} style="width:100%">{contactLabel}</a>
      </div>
    ) : null}
  </div>
</header>

<script>
  const toggle = document.getElementById('nrg-menu-toggle');
  const drawer = document.getElementById('nrg-drawer');
  toggle?.addEventListener('click', () => drawer?.classList.toggle('is-open'));
</script>
