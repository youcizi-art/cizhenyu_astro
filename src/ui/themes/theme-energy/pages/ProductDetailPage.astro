---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import ProductSeoSections from '@/ui/blocks/ProductSeoSections.astro';
import type { ProductDetail } from '@/modules/product';

interface Props {
  product: ProductDetail | null;
  backHref: string;
  backLabel?: string;
  homeHref: string;
  homeLabel?: string;
  listLabel?: string;
  specsTitle?: string;
  inquiryTitle?: string;
  inquiryBody?: string;
  contactHref?: string;
  contactLabel?: string;
  sectionLabels?: Record<string, string>;
  error?: string;
  warnings?: string[];
}
const {
  product,
  backHref,
  backLabel = '← Products',
  homeHref,
  homeLabel = 'Home',
  listLabel = 'Products',
  specsTitle = 'Technical Specifications',
  inquiryTitle = 'Product Inquiry',
  inquiryBody = 'Ask about wholesale pricing, MOQ, and OEM options.',
  contactHref = '',
  contactLabel = 'Contact',
  sectionLabels = {},
  error,
  warnings = [],
} = Astro.props;

const images = product?.imageUrls?.length
  ? product.imageUrls
  : product?.coverUrl
    ? [product.coverUrl]
    : [];
const mainImage = images[0] || '';
const thumbs = images;
const inquiryHref = product?.inquiryHref || contactHref || backHref;
---
<PageBanner
  title={product?.title || listLabel}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: listLabel, href: backHref },
    { label: product?.title || listLabel },
  ]}
/>
<section class="tm-section tm-section-white tm-product-detail">
  <div class="tm-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
    {product ? (
      <div class="tm-detail-grid">
        <div class="tm-gallery" data-tm-gallery>
          {mainImage ? (
            <OptimizedImage
              class="tm-gallery-main"
              src={mainImage}
              alt={product.title}
              width={900}
              height={900}
              widths={[480, 720, 900, 1200]}
              sizes="(max-width: 900px) 100vw, 560px"
              priority
            />
          ) : (
            <div class="tm-gallery-main tm-gallery-empty">No image</div>
          )}
          {thumbs.length > 1 ? (
            <div class="tm-gallery-thumbs">
              {thumbs.map((src, idx) => (
                <button
                  type="button"
                  class={`tm-gallery-thumb${idx === 0 ? ' is-active' : ''}`}
                  data-tm-gallery-thumb
                  data-src={src}
                  aria-label={`Image ${idx + 1}`}
                >
                  <OptimizedImage
                    src={src}
                    alt=""
                    width={120}
                    height={120}
                    widths={[80, 120]}
                    sizes="80px"
                    fill
                  />
                </button>
              ))}
            </div>
          ) : null}
        </div>

        <div class="tm-product-info">
          <h1 class="tm-display tm-product-title">{product.title}</h1>
          {product.tagline ? <p class="tm-prose tm-product-summary">{product.tagline}</p> : null}
          {product.sku ? <span class="tm-sku">Model: {product.sku}</span> : null}
          {product.brand ? <p class="tm-prose" style="margin:0.75rem 0 0">{product.brand}</p> : null}
          {product.summary ? <p class="tm-prose tm-product-summary">{product.summary}</p> : null}
          {(product.price || product.availability) ? (
            <p class="tm-product-price">
              {product.price ? `${product.currency} ${product.price}` : ''}
              {product.availability ? ` · ${product.availability}` : ''}
            </p>
          ) : null}

          {product.specs?.length ? (
            <section class="tm-specs-wrap">
              <h2 class="tm-display">{specsTitle}</h2>
              <table class="tm-specs">
                <thead>
                  <tr>
                    <th>Spec</th>
                    <th>Value</th>
                  </tr>
                </thead>
                <tbody>
                  {product.specs.map((row) => (
                    <tr>
                      <th>{row.key}</th>
                      <td>{row.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ) : null}

          {product.descriptionHtml ? (
            <div class="tm-prose tm-product-desc" set:html={product.descriptionHtml} />
          ) : null}

          <div class="tm-product-seo-wrap">
            <ProductSeoSections
              product={{ ...product, inquiryHref: '', inquiryLabel: '' }}
              labels={{
                ...sectionLabels,
                inquiryTitle: '',
                inquiryBody: '',
                inquiryCta: '',
              }}
              classPrefix="tm-product-seo"
            />
          </div>

          <div class="tm-panel tm-inquiry-box">
            <h2 class="tm-display">{inquiryTitle}</h2>
            <p>{inquiryBody}</p>
            <p style="margin-top:1rem">
              <a class="tm-btn tm-btn-md tm-btn-primary" href={inquiryHref}>{contactLabel}</a>
              <a class="tm-btn tm-btn-md tm-btn-outline" href={backHref} style="margin-left:0.75rem">{backLabel}</a>
            </p>
          </div>
        </div>
      </div>
    ) : null}
  </div>
</section>

<script>
  const root = document.querySelector('[data-tm-gallery]');
  const main = root?.querySelector('img.tm-gallery-main');
  const thumbs = root?.querySelectorAll('[data-tm-gallery-thumb]');
  thumbs?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src');
      if (!src || !(main instanceof HTMLImageElement)) return;
      main.src = src;
      main.removeAttribute('srcset');
      thumbs.forEach((t) => t.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });
</script>
