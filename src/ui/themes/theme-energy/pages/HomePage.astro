---
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import AdvantageSection from '../components/AdvantageSection.astro';
import CaseGrid from '../components/CaseGrid.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import FactoryGallery from '../components/FactoryGallery.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Alerts from '../components/Alerts.astro';
import type { ContentBlock } from '@/modules/content-block';
import type { ProductCard } from '@/modules/product';
import type { ArticleCard } from '@/modules/article';
import type { CaseStudyCard } from '@/modules/case-study';
import type { SolutionCard } from '@/modules/industry';
import type { CompanyView } from '@/modules/company';

interface Props {
  siteName: string;
  hero: ContentBlock | null;
  heroImageUrl?: string;
  tagline?: string;
  products: ProductCard[];
  caseStudies: CaseStudyCard[];
  articles: ArticleCard[];
  solutions?: SolutionCard[];
  company: CompanyView;
  companyIntro?: string;
  companyStats?: Array<{ label: string; value: string }>;
  ctaBanner: ContentBlock | null;
  advantages?: Array<{ title: string; description: string }>;
  testimonials?: Array<{
    name: string;
    role?: string;
    quote: string;
    avatarUrl?: string;
    meta?: string;
    rating?: number;
  }>;
  factoryItems?: Array<{ title: string; imageUrl: string }>;
  heroThumbs?: Array<{ src: string; free?: boolean; alt?: string }>;
  labels: Record<string, string>;
  paths: {
    about: string;
    contact: string;
    products?: string;
    solutions?: string;
  };
  error?: string;
  warnings?: string[];
  showProducts?: boolean;
  showArticles?: boolean;
}
const {
  siteName,
  hero,
  heroImageUrl = '',
  tagline = '',
  products,
  caseStudies,
  articles,
  solutions = [],
  company,
  companyIntro = '',
  companyStats = [],
  ctaBanner,
  advantages = [],
  testimonials = [],
  factoryItems = [],
  heroThumbs = [],
  labels,
  paths,
  error,
  warnings = [],
  showProducts = true,
  showArticles = true,
} = Astro.props;

const heroTitle = hero?.title || siteName;
const heroSummary = hero?.summary || hero?.subtitle || tagline;
const heroImage = hero?.imageUrl || heroImageUrl;
const heroCta = hero?.ctaUrl || paths.contact;
const heroCtaLabel = hero?.ctaLabel || labels.aboutCta || 'Learn More';
const heroTips = labels.heroTips || hero?.eyebrow || '';
const ctaBg =
  ctaBanner?.backgroundImageUrl ||
  'https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=1600&h=600&q=80';
---
{(error || warnings.length) ? (
  <div class="tm-container" style="padding-top:1rem">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
  </div>
) : null}

<!-- 1. Hero -->
<Hero
  title={heroTitle}
  summary={heroSummary}
  image={heroImage}
  eyebrow={heroTips}
  actionUrl={heroCta}
  actionLabel={heroCtaLabel}
  thumbs={heroThumbs}
/>

<!-- 2. Products -->
{showProducts ? (
  <ProductGrid
    title={labels.products}
    eyebrow={labels.productsEyebrow}
    subtitle={labels.productsSub}
    items={products}
    readMoreText={labels.readMore}
    variant="home"
  />
) : null}

<!-- 3. Category / solutions strip -->
<CategoryStrip
  title={labels.category}
  subtitle={labels.categorySub}
  items={solutions.map((s) => ({
    title: s.title,
    href: s.href,
    summary: s.summary,
    coverUrl: s.coverUrl,
  }))}
  ctaHref={paths.solutions || paths.products}
  ctaLabel={labels.exploreAll}
/>

<!-- 4. Advantages (dark) -->
<AdvantageSection
  title={labels.advantages}
  subtitle={labels.advantagesSub}
  items={advantages}
/>

<!-- 5. Case studies / real stories -->
<CaseGrid
  title={labels.cases}
  subtitle={labels.casesSub}
  cases={caseStudies.map((item) => ({
    title: item.title,
    href: item.href,
    summary: item.summary,
    coverUrl: item.coverUrl,
    industry: item.industry,
  }))}
/>

<!-- 6. About -->
<AboutTeaser
  companyName={labels.aboutTitle || company.name || siteName}
  slogan={company.slogan}
  summary={companyIntro || company.summary}
  logoUrl={company.logoUrl}
  aboutHref={paths.about}
  aboutLabel={labels.about}
  stats={companyStats}
/>

<!-- 7. Factory -->
<FactoryGallery
  eyebrow={labels.factoryEyebrow}
  title={labels.factory}
  description={company.summary}
  factoryArea={labels.factoryArea}
  items={factoryItems}
/>

<!-- 8. CTA -->
<CtaBanner
  title={ctaBanner?.title || 'Ready to make pet care easier?'}
  actionLabel={ctaBanner?.ctaLabel || labels.aboutCta}
  actionHref={ctaBanner?.ctaUrl || paths.contact}
  backgroundImage={ctaBg}
/>

<!-- 9. Testimonials -->
<TestimonialSection
  eyebrow={labels.testimonialsEyebrow}
  title={labels.testimonials}
  subtitle={labels.testimonialsSub}
  items={testimonials}
/>

<!-- 10. Articles -->
{showArticles ? (
  <ArticleGrid title={labels.articles} items={articles} readMoreText={labels.readMore} />
) : null}
