---
import { siteOrigin, toAbsoluteUrl, toOgLocale } from '@/modules/seo';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  robots?: string;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  siteName?: string;
  locale?: string;
  alternateLocales?: string[];
  alternates?: Array<{ href: string; hreflang: string }>;
  jsonLd?: Record<string, unknown> | null;
}
const {
  title,
  description = '',
  canonicalUrl = '',
  robots = '',
  ogImage = '',
  ogType = 'website',
  ogUrl = '',
  siteName = '',
  locale = '',
  alternateLocales = [],
  alternates = [],
  jsonLd = null,
} = Astro.props;

// 优先采用配置的 siteOrigin，若未配置则自动使用 Astro.site 或当前请求的 Astro.url.origin 确保生成绝对网址
const currentOrigin =
  siteOrigin() ||
  (Astro.site ? String(Astro.site).replace(/\/$/, '') : '') ||
  (Astro.url ? Astro.url.origin : '');

const canonical = canonicalUrl ? toAbsoluteUrl(canonicalUrl, currentOrigin) : '';
const image = ogImage ? toAbsoluteUrl(ogImage, currentOrigin) : '';
const shareUrl = ogUrl ? toAbsoluteUrl(ogUrl, currentOrigin) : canonical;
const jsonLdText = jsonLd ? JSON.stringify(jsonLd) : '';
const ogLocale = locale ? toOgLocale(locale) : '';
const ogLocaleAlts = (alternateLocales.length ? alternateLocales : alternates.map((a) => a.hreflang))
  .filter((code) => code && code !== 'x-default')
  .map((code) => toOgLocale(code))
  .filter((code) => code && code !== ogLocale);
---
{description ? <meta name="description" content={description} /> : null}
{robots ? <meta name="robots" content={robots} /> : null}
{canonical ? <link rel="canonical" href={canonical} /> : null}
{alternates.map((item) => (
  <link rel="alternate" hreflang={item.hreflang} href={toAbsoluteUrl(item.href, currentOrigin)} />
))}
<meta property="og:title" content={title} />
{description ? <meta property="og:description" content={description} /> : null}
<meta property="og:type" content={ogType || 'website'} />
{shareUrl ? <meta property="og:url" content={shareUrl} /> : null}
{image ? <meta property="og:image" content={image} /> : null}
{siteName ? <meta property="og:site_name" content={siteName} /> : null}
{ogLocale ? <meta property="og:locale" content={ogLocale} /> : null}
{ogLocaleAlts.map((code) => (
  <meta property="og:locale:alternate" content={code} />
))}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
{description ? <meta name="twitter:description" content={description} /> : null}
{image ? <meta name="twitter:image" content={image} /> : null}
{jsonLdText ? <script type="application/ld+json" set:html={jsonLdText} /> : null}
