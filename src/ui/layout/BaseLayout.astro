---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  alternates?: Array<{ href: string; hreflang: string }>;
}
const { title, description = '', lang = 'en', alternates = [] } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {alternates.map((item) => (
      <link rel="alternate" hreflang={item.hreflang} href={item.href} />
    ))}
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #14213d;
        --muted: #5c6b7a;
        --line: #d9e2ec;
        --bg: #f7f9fc;
        --accent: #0b3d91;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 1.5rem; width: 100%; }
      main.wrap { flex: 1; }
      header.site {
        border-bottom: 1px solid var(--line);
        background: #fff;
      }
      header.site .wrap {
        display: flex;
        gap: 1.25rem;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
      }
      .header-right {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
      }
      nav { display: flex; gap: 0.85rem; flex-wrap: wrap; }
      .lang-switch { display: flex; gap: 0.5rem; align-items: center; font-size: 0.9rem; }
      .lang-active { font-weight: 700; color: var(--ink); }
      .site-footer {
        border-top: 1px solid var(--line);
        background: #fff;
        margin-top: 2rem;
      }
      .footer-meta { margin-top: 0.75rem; }
      .muted { color: var(--muted); }
      .card-list { display: grid; gap: 1rem; margin-top: 1.25rem; }
      .card {
        background: #fff;
        border: 1px solid var(--line);
        padding: 1rem 1.25rem;
      }
      .card-media {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-radius: 4px;
        margin-bottom: 0.75rem;
        background: #eef2f7;
      }
      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 0.75rem;
        margin: 1rem 0;
      }
      .gallery img {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border: 1px solid var(--line);
        background: #fff;
      }
      .hero {
        background: #fff;
        border: 1px solid var(--line);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .hero .eyebrow {
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.85rem;
      }
      .section { margin-top: 2rem; }
      .pager { display: flex; gap: 1rem; margin-top: 1.25rem; align-items: center; }
      .alert { margin: 1rem 0; padding: 0.75rem 1rem; border: 1px solid; }
      .alert p { margin: 0.25rem 0; }
      .alert-error { background: #fff4f4; border-color: #f5c2c2; color: #8a1f1f; }
      .alert-warn { background: #fff8e8; border-color: #f0d48a; color: #7a5b00; }
      .prose :global(p) { margin: 0.75rem 0; }
      .prose :global(img) { max-width: 100%; height: auto; }
      .faq-item { margin-bottom: 1rem; }
      .faq-item summary { cursor: pointer; font-weight: 600; }
      table.specs {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid var(--line);
      }
      table.specs th,
      table.specs td {
        text-align: left;
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      table.specs th { width: 32%; color: var(--muted); font-weight: 600; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
