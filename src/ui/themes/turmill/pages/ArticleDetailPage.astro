---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import { articleContentTypeLabel, type ArticleDetail } from '@/modules/article';

interface Props {
  article: ArticleDetail | null;
  backHref: string;
  backLabel?: string;
  homeHref: string;
  homeLabel?: string;
  listLabel?: string;
  sidebarTitle?: string;
  sidebarBody?: string;
  contactHref?: string;
  contactLabel?: string;
  relatedTitle?: string;
  related?: Array<{ title: string; href: string; date?: string }>;
  locale?: string;
  error?: string;
  warnings?: string[];
}
const {
  article,
  backHref,
  backLabel = '← Back to Blog List',
  homeHref,
  homeLabel = 'Home',
  listLabel = 'Blog',
  sidebarTitle = 'Need a Solution?',
  sidebarBody = 'We are a certified manufacturer supplying premium products globally.',
  contactHref = '',
  contactLabel = 'Contact Us Now',
  relatedTitle = 'Recommended Insights',
  related = [],
  locale = 'en',
  error,
  warnings = [],
} = Astro.props;
const typeLabel = article ? articleContentTypeLabel(article.contentType, locale) : '';
---
<PageBanner
  title={article?.title || listLabel}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: listLabel, href: backHref },
    { label: article?.title || listLabel },
  ]}
/>
<section class="tm-section tm-section-white">
  <div class="tm-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
    {article ? (
      <div class="tm-article-layout">
        <article class="tm-article-main">
          <div class="tm-article-meta">
            {typeLabel ? <span class="tm-article-type">{typeLabel}</span> : null}
            {article.author ? <span>{article.author}</span> : null}
          </div>
          <h2 class="tm-display tm-article-headline">{article.title}</h2>
          {article.coverUrl ? (
            <div class="tm-article-cover">
              <img src={article.coverUrl} alt={article.title} width="1200" height="630" />
            </div>
          ) : null}
          {article.summary ? <p class="tm-article-lead">{article.summary}</p> : null}
          {article.content ? <div class="tm-prose tm-prose-article" set:html={article.content} /> : null}
          <p style="margin-top:2.5rem">
            <a class="tm-btn tm-btn-md tm-btn-primary-line" href={backHref}>{backLabel}</a>
          </p>
        </article>
        <aside class="tm-article-side">
          {related.length ? (
            <div class="tm-panel tm-related-box">
              <h3 class="tm-display">{relatedTitle}</h3>
              <ul class="tm-related-list">
                {related.map((item) => (
                  <li>
                    <a href={item.href}>{item.title}</a>
                    {item.date ? <span>{item.date}</span> : null}
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
          <div class="tm-panel tm-side-cta tm-side-cta-dark">
            <h3 class="tm-display">{sidebarTitle}</h3>
            <p>{sidebarBody}</p>
            {contactHref ? (
              <a class="tm-btn tm-btn-md tm-btn-primary" href={contactHref}>{contactLabel}</a>
            ) : null}
          </div>
        </aside>
      </div>
    ) : null}
  </div>
</section>
