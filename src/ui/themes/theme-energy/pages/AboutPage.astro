---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { CompanyView } from '@/modules/company';

interface Props {
  title: string;
  summary?: string;
  content?: string;
  company: CompanyView;
  homeHref: string;
  homeLabel?: string;
  error?: string;
  warnings?: string[];
}

const {
  title,
  summary = '',
  content = '',
  company,
  homeHref,
  homeLabel = 'Home',
  error,
  warnings = [],
} = Astro.props;
---

<PageBanner
  title={title}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: title },
  ]}
/>

<section class="nrg-section">
  <div class="nrg-container" style="max-width: 900px">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />

    <div style="margin-bottom: 3rem">
      <h1 class="nrg-title" style="margin-bottom: 1.5rem">{company.name}</h1>
      {summary ? <p class="nrg-lead" style="margin-bottom: 2rem">{summary}</p> : null}
    </div>

    {content ? (
      <div class="nrg-prose" set:html={content} />
    ) : null}
  </div>
</section>
