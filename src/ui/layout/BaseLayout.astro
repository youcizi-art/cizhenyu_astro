---
import SeoHead from './SeoHead.astro';
import { loadSiteManifest } from '@/modules/site';
import { getThemeMeta, resolveTheme } from '@/ui/themes';
import '@/ui/themes/styles';
import '@/ui/layout/chrome.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  alternates?: Array<{ href: string; hreflang: string }>;
  canonicalUrl?: string;
  robots?: string;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  jsonLd?: Record<string, unknown> | null;
  siteName?: string;
}

const {
  title,
  description = '',
  lang = 'en',
  alternates = [],
  canonicalUrl = '',
  robots = '',
  ogImage = '',
  ogType = 'website',
  ogUrl = '',
  jsonLd = null,
  siteName = '',
} = Astro.props;

const site = loadSiteManifest();
const { themeId, primaryColor } = resolveTheme({
  theme: site.theme,
  primaryColor: site.brand?.primaryColor,
});
const meta = getThemeMeta(themeId);
const rootStyle = primaryColor ? `--accent: ${primaryColor}` : undefined;
const resolvedSiteName = siteName || site.displayName || site.siteKey;
---
<!doctype html>
<html lang={lang} data-theme={themeId} data-site={site.siteKey} style={rootStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {meta.fontHref ? (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={meta.fontHref} rel="stylesheet" />
      </>
    ) : null}
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      robots={robots}
      ogImage={ogImage}
      ogType={ogType}
      ogUrl={ogUrl}
      siteName={resolvedSiteName}
      locale={lang}
      alternates={alternates}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
