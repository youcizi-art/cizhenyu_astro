# =============================================================================
# cizhenyu_astro — 通用本地 / 生产环境变量模板
# 复制为 .env 后按「当前要跑的前端站」修改。勿把含真实 secret 的 .env 提交 Git。
# =============================================================================

# --- 本地联调（默认对接本机 CMS）---
PUBLIC_CMS_API_BASE=http://127.0.0.1:5173
PUBLIC_CMS_API_PREFIX=/api/p
PUBLIC_MEDIA_BASE=
PUBLIC_SITE_URL=http://localhost:4321

# 选哪份 sites/<SITE_KEY>/site.manifest.json（须已在 load-site registry 注册）
# SITE_KEY ≡ cms.collectionNamespace ≡ CMS frontend_sites.siteKey
SITE_KEY=demo
REVALIDATE_SECRET=dev-revalidate-secret

# CMS 调用：http（本地/公网）| service（同账号 Pages→Worker Binding，生产推荐）
CMS_TRANSPORT=http
# CMS_SERVICE_BINDING=CMS

# --- 生产示例（部署工具会生成 pages.env，勿手写死某个客户域）---
# SITE_KEY=brand-a
# PUBLIC_SITE_URL=https://www.brand-a.example
# PUBLIC_CMS_API_BASE=https://api.customer-zone.example
# PUBLIC_CMS_API_PREFIX=/api/p
# PUBLIC_MEDIA_BASE=https://cdn.customer-zone.example
# REVALIDATE_SECRET=<每站独立随机串>
# CMS_TRANSPORT=service
# CMS_SERVICE_BINDING=CMS

# 可选：HTML 缓存调试
# HTML_CACHE_IN_DEV=1
# DISABLE_HTML_CACHE=1

# 可选：CDN purge
# CF_ZONE_ID=
# CF_API_TOKEN=

# 说明：
# - 多客户 = 多个 CMS apiBase（不同 Worker/D1）
# - 同客户多站 = 同一 apiBase + 不同 SITE_KEY/ns
# - 部署产物由 D:\ycz_me\objct\cizhenyu_create 生成
