---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import ProductSeoSections from '@/ui/blocks/ProductSeoSections.astro';
import type { ProductDetail } from '@/modules/product';

interface Props {
  product: ProductDetail | null;
  backHref: string;
  backLabel?: string;
  homeHref: string;
  homeLabel?: string;
  listLabel?: string;
  specsTitle?: string;
  inquiryTitle?: string;
  inquiryBody?: string;
  contactHref?: string;
  contactLabel?: string;
  sectionLabels?: Record<string, string>;
  error?: string;
  warnings?: string[];
}
const {
  product,
  backHref,
  backLabel = '← 返回产品',
  homeHref,
  homeLabel = '首页',
  listLabel = '产品',
  specsTitle = '模块信息',
  inquiryTitle = '产品方案咨询',
  inquiryBody = '磁帧鱼产品采用组合方案交付，包含标准建站（$399）、智能营销（$1,099）与源码 Enterprise｜企业定制版（$1,999起，按需求报价）。告诉我们您的行业与现状，获取适合当前阶段的方案建议。',
  contactHref = '',
  contactLabel = '提交询盘',
  sectionLabels = {},
  error,
  warnings = [],
} = Astro.props;

const images = product?.imageUrls?.length
  ? product.imageUrls
  : product?.coverUrl
    ? [product.coverUrl]
    : [];
const mainImage = images[0] || '';
const thumbs = images;
const inquiryHref = product?.inquiryHref || contactHref || backHref;
const descTitle = sectionLabels.description || (backLabel.includes('返回') ? '详细介绍' : 'Product Details');
---
<PageBanner
  title={product?.title || listLabel}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: listLabel, href: backHref },
    { label: product?.title || listLabel },
  ]}
/>
<section class="cz-page-section">
  <div class="cz-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />
    {product ? (
      <div class="cz-product-detail-layout">
        <!-- 上部分：左右布局（左产品图，右规格、标题、简介、快速咨询） -->
        <div class="cz-product-hero-grid">
          <div class="cz-product-gallery-wrap" data-cz-gallery>
            {mainImage ? (
              <OptimizedImage
                class="cz-gallery-main"
                src={mainImage}
                alt={product.title}
                width={900}
                height={675}
                widths={[480, 720, 900]}
                sizes="(max-width: 900px) 100vw, 560px"
                priority
              />
            ) : (
              <div class="cz-gallery-main cz-media-placeholder" aria-hidden="true">
                <svg viewBox="0 0 96 96" width="64" height="64" fill="none">
                  <rect x="12" y="20" width="72" height="56" rx="10" stroke="currentColor" stroke-width="2.5" opacity="0.28"></rect>
                  <circle cx="36" cy="42" r="7" stroke="currentColor" stroke-width="2.5" opacity="0.4"></circle>
                  <path d="M18 68l22-18 14 12 14-20 14 26" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4"></path>
                </svg>
                <span>{product.title}</span>
              </div>
            )}
            {thumbs.length > 1 ? (
              <div class="cz-gallery-thumbs">
                {thumbs.map((src, idx) => (
                  <button
                    type="button"
                    class={`cz-gallery-thumb${idx === 0 ? ' is-active' : ''}`}
                    data-cz-gallery-thumb
                    data-src={src}
                    aria-label={`Image ${idx + 1}`}
                  >
                    <OptimizedImage src={src} alt="" width={120} height={120} widths={[80, 120]} sizes="72px" fill />
                  </button>
                ))}
              </div>
            ) : null}
          </div>

          <div class="cz-product-hero-info">
            <h1 class="cz-product-detail-title">{product.title}</h1>
            {product.tagline ? <p class="cz-product-detail-tagline">{product.tagline}</p> : null}

            {(product.sku || product.brand) ? (
              <div class="cz-product-meta-pills">
                {product.sku ? <span class="cz-sku">{product.sku}</span> : null}
                {product.brand ? <span class="cz-brand-pill">{product.brand}</span> : null}
              </div>
            ) : null}

            {product.summary ? <p class="cz-product-detail-summary">{product.summary}</p> : null}

            {product.specs?.length ? (
              <div class="cz-product-specs-box">
                <h2 class="cz-specs-heading">{specsTitle}</h2>
                <table class="cz-specs">
                  <tbody>
                    {product.specs.map((row) => (
                      <tr>
                        <th>{row.key}</th>
                        <td>{row.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : null}

            <div class="cz-product-hero-actions">
              <a class="cz-btn cz-btn-primary" href={inquiryHref} data-cf-chat="open">{contactLabel}</a>
              <a class="cz-btn cz-btn-ghost" href={backHref}>{backLabel}</a>
            </div>
          </div>
        </div>

        <!-- 下部分：产品详情以及其他模块信息 -->
        <div class="cz-product-bottom-layout">
          {product.descriptionHtml ? (
            <section class="cz-product-desc-section">
              <h2 class="cz-desc-heading">{descTitle}</h2>
              <div class="cz-prose" set:html={product.descriptionHtml} />
            </section>
          ) : null}

          <div class="cz-product-seo-wrap">
            <ProductSeoSections
              product={{ ...product, inquiryHref: '', inquiryLabel: '' }}
              labels={{
                ...sectionLabels,
                inquiryTitle: '',
                inquiryBody: '',
                inquiryCta: '',
              }}
              classPrefix="cz-product-seo"
            />
          </div>

          <div class="cz-inquiry-box cz-product-inquiry-card">
            <h2>{inquiryTitle}</h2>
            <p>{inquiryBody}</p>
            <div class="cz-inquiry-actions">
              <a class="cz-btn cz-btn-primary" href={inquiryHref} data-cf-chat="open">{contactLabel}</a>
              <a class="cz-btn cz-btn-ghost" href={backHref}>{backLabel}</a>
            </div>
          </div>
        </div>
      </div>
    ) : null}
  </div>
</section>

<script>
  const root = document.querySelector('[data-cz-gallery]');
  const main = root?.querySelector('img.cz-gallery-main');
  const thumbs = root?.querySelectorAll('[data-cz-gallery-thumb]');
  thumbs?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src');
      if (!src || !(main instanceof HTMLImageElement)) return;
      main.src = src;
      main.removeAttribute('srcset');
      thumbs.forEach((t) => t.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });
</script>
