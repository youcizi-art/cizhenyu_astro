---
import SeoHead from './SeoHead.astro';
import { loadSiteManifest } from '@/modules/site';
import { resolveTheme } from '@/ui/themes';
import '@/ui/themes/default/tokens.css';
import '@/ui/themes/turmill/tokens.css';
import '@/ui/themes/turmill/theme.css';
import '@/ui/layout/chrome.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  alternates?: Array<{ href: string; hreflang: string }>;
  canonicalUrl?: string;
  robots?: string;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description = '',
  lang = 'en',
  alternates = [],
  canonicalUrl = '',
  robots = '',
  ogImage = '',
  ogType = 'website',
  ogUrl = '',
  jsonLd = null,
} = Astro.props;

const site = loadSiteManifest();
const { themeId, primaryColor } = resolveTheme({
  theme: site.theme,
  primaryColor: site.brand?.primaryColor,
});

const rootStyle = primaryColor ? `--accent: ${primaryColor}` : undefined;
const loadBrandFonts = themeId === 'turmill';
---
<!doctype html>
<html lang={lang} data-theme={themeId} data-site={site.siteKey} style={rootStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {loadBrandFonts ? (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Yeseva+One&display=swap"
          rel="stylesheet"
        />
      </>
    ) : null}
    <SeoHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      robots={robots}
      ogImage={ogImage}
      ogType={ogType}
      ogUrl={ogUrl}
      alternates={alternates}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
