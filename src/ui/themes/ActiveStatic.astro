---
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import DefaultAboutPage from './default/pages/AboutPage.astro';
import DefaultContactPage from './default/pages/ContactPage.astro';
import DefaultFaqPage from './default/pages/FaqPage.astro';
import TurmillAboutPage from './turmill/pages/AboutPage.astro';
import TurmillContactPage from './turmill/pages/ContactPage.astro';
import TurmillFaqPage from './turmill/pages/FaqPage.astro';
import { getThemeMeta } from './theme-ui';
import { t } from '@/modules/i18n';
import type { PageChrome } from '@/workflows/chrome/load-chrome';

interface Props {
  chrome: PageChrome;
  kind: 'about' | 'contact' | 'faq';
  title: string;
  summary?: string;
  content?: string;
  references?: any[];
  faqItems?: Array<{ question: string; answer: string; shortAnswer?: string }>;
  emptyHint?: string;
  error?: string;
}
const {
  chrome,
  kind,
  title,
  summary = '',
  content = '',
  references = [],
  faqItems = [],
  emptyHint = '',
  error,
} = Astro.props;
const meta = getThemeMeta(chrome.site.theme);
const homeHref = `/${chrome.locale}`;
const homeLabel = t(chrome.locale, 'home');
const relatedTitle = chrome.locale.startsWith('zh') ? '相关内容' : 'Related';
const shortAnswerLabel = chrome.locale.startsWith('zh') ? '简答' : chrome.locale === 'ja' ? '簡潔な回答' : 'Short answer';
---
{meta.id === 'default' && kind === 'about' ? (
  <DefaultAboutPage
    title={title}
    summary={summary}
    content={content}
    company={chrome.company}
    references={references}
    relatedTitle={relatedTitle}
    homeHref={homeHref}
    homeLabel={homeLabel}
    error={error}
    warnings={chrome.warnings}
    emptyHint={emptyHint}
  />
) : meta.id === 'default' && kind === 'contact' ? (
  <DefaultContactPage
    title={title}
    content={content}
    company={chrome.company}
    homeHref={homeHref}
    homeLabel={homeLabel}
    error={error}
    warnings={chrome.warnings}
    emptyHint={emptyHint}
    inquiryLabel={chrome.locale.startsWith('zh') ? '提交询盘' : 'Send inquiry'}
    inquiryHint={
      chrome.locale.startsWith('zh')
        ? '在线表单即将接入；当前点击为预留入口，也可直接发送邮件。下载安装同样走询盘协作。'
        : 'Online form coming soon. This button is reserved — email us, or inquire for collaborative install.'
    }
    mailLabel={chrome.locale.startsWith('zh') ? '发送邮件' : 'Email us'}
  />
) : meta.id === 'default' && kind === 'faq' ? (
  <DefaultFaqPage
    title={title}
    items={faqItems}
    homeHref={homeHref}
    homeLabel={homeLabel}
    shortAnswerLabel={shortAnswerLabel}
    emptyText={emptyHint || (chrome.locale.startsWith('zh') ? '暂无 FAQ。' : 'No FAQs yet.')}
    error={error}
    warnings={chrome.warnings}
  />
) : meta.id === 'turmill' && kind === 'about' ? (
  <TurmillAboutPage
    title={title}
    summary={summary}
    content={content}
    company={chrome.company}
    references={references}
    relatedTitle={relatedTitle}
    homeHref={homeHref}
    homeLabel={homeLabel}
    error={error}
    warnings={chrome.warnings}
    emptyHint={emptyHint}
  />
) : meta.id === 'turmill' && kind === 'contact' ? (
  <TurmillContactPage
    title={title}
    content={content}
    company={chrome.company}
    homeHref={homeHref}
    homeLabel={homeLabel}
    error={error}
    warnings={chrome.warnings}
    emptyHint={emptyHint}
  />
) : meta.id === 'turmill' && kind === 'faq' ? (
  <TurmillFaqPage
    title={title}
    items={faqItems}
    homeHref={homeHref}
    homeLabel={homeLabel}
    shortAnswerLabel={shortAnswerLabel}
    emptyText={emptyHint || (chrome.locale.startsWith('zh') ? '暂无 FAQ。' : 'No FAQs yet.')}
    error={error}
    warnings={chrome.warnings}
  />
) : kind === 'faq' ? (
  <>
    <h1>{title}</h1>
    <AlertBanner messages={error ? [error] : []} />
    {faqItems.map((item) => (
      <details class="faq-item card">
        <summary>{item.question}</summary>
        <div class="prose" set:html={item.answer} />
      </details>
    ))}
  </>
) : (
  <>
    <AlertBanner messages={error ? [error] : []} />
    <h1>{title}</h1>
    {content ? <div class="prose" set:html={content} /> : null}
  </>
)}
