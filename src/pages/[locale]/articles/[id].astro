---
import BaseLayout from '@/ui/layout/BaseLayout.astro';
import SiteHeader from '@/ui/layout/SiteHeader.astro';
import SiteFooter from '@/ui/layout/SiteFooter.astro';
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import TurmillPageShell from '@/ui/themes/turmill/PageShell.astro';
import TurmillArticleDetailPage from '@/ui/themes/turmill/pages/ArticleDetailPage.astro';
import { loadArticleDetailPage } from '@/workflows/articles/load-article-detail';
import { applyCacheHeaders } from '@/workflows/chrome/http';
import { buildAlternateLinks } from '@/workflows/chrome/urls';
import { t } from '@/modules/i18n';
import { localePath } from '@/modules/cms';
import { layoutSeoProps, pageJsonLd } from '@/modules/seo';
import { buildTurmillShellProps, useTurmillShell } from '@/ui/themes';

export const prerender = false;

const id = String(Astro.params.id || '').trim();
const data = await loadArticleDetailPage({
  locale: Astro.params.locale,
  pathname: Astro.url.pathname,
  id,
});
if (!data.localeValid) return Astro.redirect(`/${data.site.defaultLocale}/articles`, 302);
applyCacheHeaders(Astro.response.headers, data.revalidateSeconds);
if (!data.enabled) return Astro.rewrite('/404');
if (!data.error && !data.article) return Astro.rewrite('/404');
const article = data.article;
const seoProps = layoutSeoProps(article?.seo, Astro.url.pathname);
const jsonLd = article
  ? pageJsonLd(article.seo, Astro.url.pathname, {
      siteName: data.siteName,
      company: data.company,
      article: {
        headline: article.title,
        description: article.summary || article.seoDescription,
        imageUrl: article.coverUrl,
        author: article.author,
      },
    })
  : null;
const turmill = useTurmillShell(data.site.theme);
const shell = buildTurmillShellProps(data);
const listHref = localePath(data.locale, '/articles');
const listLabel = t(data.locale, 'articles');
---
<BaseLayout
  title={`${article?.seoTitle || article?.title || listLabel} · ${data.siteName}`}
  description={article?.seoDescription || article?.summary || ''}
  lang={data.locale}
  alternates={buildAlternateLinks(data.localeOptions, { defaultLocale: data.site.defaultLocale })}
  {...seoProps}
  jsonLd={jsonLd}
>
  {turmill ? (
    <TurmillPageShell {...shell}>
      <TurmillArticleDetailPage
        article={article}
        backHref={listHref}
        backLabel={`← ${listLabel}`}
        homeHref={localePath(data.locale, '/')}
        homeLabel={t(data.locale, 'home')}
        listLabel={listLabel}
        contactHref={localePath(data.locale, '/contact')}
        contactLabel={t(data.locale, 'contact')}
        sidebarTitle={data.locale.startsWith('zh') ? '需要方案？' : 'Need a Solution?'}
        sidebarBody={data.company.summary || (data.locale.startsWith('zh')
          ? '联系我们获取规格、交期与定制方案。'
          : 'Talk to our team for specs, MOQ, and lead times.')}
        error={data.error}
        warnings={data.warnings}
      />
    </TurmillPageShell>
  ) : (
    <>
      <SiteHeader siteName={data.siteName} links={data.navLinks} localeOptions={data.localeOptions} languageLabel={data.languageLabel}
        company={data.company}
        locale={data.locale}
      />
      <main class="wrap">
        <p><a href={listHref}>← {listLabel}</a></p>
        <AlertBanner messages={data.error ? [data.error] : []} />
        <AlertBanner messages={data.warnings} tone="warn" />
        {article ? (
          <>
            <h1>{article.title}</h1>
            {article.author ? <p class="muted">{article.author}</p> : null}
            {article.coverUrl ? <p><img class="card-media" src={article.coverUrl} alt={article.title} /></p> : null}
            {article.summary ? <p>{article.summary}</p> : null}
            {article.content ? <div class="prose" set:html={article.content} /> : null}
          </>
        ) : null}
      </main>
      <SiteFooter company={data.company} />
    </>
  )}
</BaseLayout>
