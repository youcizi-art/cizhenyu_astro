---
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { ContentBlock } from '@/modules/content-block';
import type { ProductCard } from '@/modules/product';
import type { CompanyView } from '@/modules/company';

interface Props {
  siteName: string;
  hero: ContentBlock | null;
  heroImageUrl?: string;
  tagline?: string;
  products: ProductCard[];
  company: CompanyView;
  companyIntro?: string;
  ctaBanner: ContentBlock | null;
  advantages?: Array<{ title: string; description: string }>;
  labels: Record<string, string>;
  paths: {
    about: string;
    contact: string;
    products?: string;
    solutions?: string;
  };
  error?: string;
  warnings?: string[];
  showProducts?: boolean;
}
const {
  siteName,
  hero,
  heroImageUrl = '',
  tagline = '',
  products,
  company,
  ctaBanner,
  advantages = [],
  labels,
  paths,
  error,
  warnings = [],
  showProducts = true,
} = Astro.props;

const contactHref = paths.contact;
const productsHref = paths.products || contactHref;
const resourcesHref = (() => {
  const parts = contactHref.split('/').filter(Boolean);
  const locale = parts[0] || 'zh-CN';
  return `/${locale}/resources`;
})();
const heroTitle = hero?.title || siteName;
const heroLead = hero?.subtitle || hero?.summary || tagline || company.slogan || '';
const heroNote = hero?.summary && hero?.subtitle ? hero.summary : '';
const heroCtaLabel = hero?.ctaLabel || labels.ctaBtn || '免费获取方案';
const heroCtaUrl = hero?.ctaUrl || `${contactHref}?intent=inquiry`;
const mediaUrl = heroImageUrl || hero?.imageUrl || '';

const compareRows = [
  { dim: labels.compareDim1, old: labels.compareOld1, neu: labels.compareNew1 },
  { dim: labels.compareDim2, old: labels.compareOld2, neu: labels.compareNew2 },
  { dim: labels.compareDim3, old: labels.compareOld3, neu: labels.compareNew3 },
  { dim: labels.compareDim4, old: labels.compareOld4, neu: labels.compareNew4 },
];

const steps = [
  { n: '1', title: labels.step1Title, body: labels.step1Body },
  { n: '2', title: labels.step2Title, body: labels.step2Body },
  { n: '3', title: labels.step3Title, body: labels.step3Body },
];

const roles = [
  { title: labels.role1, body: labels.role1Body },
  { title: labels.role2, body: labels.role2Body },
  { title: labels.role3, body: labels.role3Body },
];

const ctaTitle = ctaBanner?.title || labels.ctaTitle;
const ctaSub = ctaBanner?.summary || ctaBanner?.subtitle || labels.ctaSub;
const ctaLabel = ctaBanner?.ctaLabel || labels.ctaBtn;
const ctaUrl = ctaBanner?.ctaUrl || resourcesHref;
---
{(error || warnings.length) ? (
  <div class="cz-container" style="padding-top:1rem">
    {error ? <p class="cz-card" style="border-color:#fecaca;color:#b91c1c">{error}</p> : null}
    {warnings.map((w) => (
      <p class="cz-card" style="border-color:#fde68a;color:#92400e;margin-top:0.5rem">{w}</p>
    ))}
  </div>
) : null}

<section class="cz-hero">
  <div class="cz-container cz-hero-grid">
    <div>
      {hero?.eyebrow ? <p class="cz-eyebrow">{hero.eyebrow}</p> : <p class="cz-eyebrow">磁帧鱼</p>}
      <h1>{heroTitle}</h1>
      {heroLead ? <p class="cz-hero-lead">{heroLead}</p> : null}
      {heroNote ? <p class="cz-hero-note">{heroNote}</p> : null}
      <div class="cz-hero-actions">
        <a class="cz-btn cz-btn-primary cz-btn-lg" href={heroCtaUrl}>{heroCtaLabel}</a>
        {showProducts ? (
          <a class="cz-btn cz-btn-ghost cz-btn-lg" href={productsHref}>{labels.exploreAll}</a>
        ) : null}
      </div>
      <ul class="cz-trust">
        <li>{labels.trust1}</li>
        <li>{labels.trust2}</li>
        <li>{labels.trust3}</li>
      </ul>
    </div>
    <div class="cz-hero-media" aria-hidden={!mediaUrl}>
      {mediaUrl ? (
        <OptimizedImage
          src={mediaUrl}
          alt={heroTitle}
          width={960}
          height={660}
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 100vw, 460px"
          priority
        />
      ) : (
        <div class="cz-hero-panel">
          <div>
            <strong>{siteName}</strong>
            <span>{labels.heroPanel || '站群 · 询盘 · 部署获客'}</span>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

{advantages.length ? (
  <section class="cz-section">
    <div class="cz-container">
      <div class="cz-section-head">
        <h2>{labels.painTitle}</h2>
        <p>{labels.painSub}</p>
      </div>
      <div class="cz-pain-grid">
        {advantages.map((item) => (
          <article class="cz-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <p class="cz-card-solve">
              <strong>{labels.solveLabel}</strong>
              {' — '}
              {labels.solveHint}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
) : null}

{showProducts && products.length ? (
  <section class="cz-section cz-section-alt">
    <div class="cz-container">
      <div class="cz-section-head">
        <h2>{labels.productsTitle}</h2>
        <p>{labels.productsSub}</p>
      </div>
      <div class="cz-product-grid">
        {products.slice(0, 3).map((p) => (
          <article class="cz-card cz-product-card">
            <a href={p.href}>
              <div class="cz-product-cover">
                {p.coverUrl ? (
                  <OptimizedImage
                    src={p.coverUrl}
                    alt={p.title}
                    width={640}
                    height={400}
                    widths={[320, 640]}
                    sizes="(max-width: 720px) 100vw, 360px"
                  />
                ) : null}
              </div>
              <div class="cz-product-body">
                <h3>{p.title}</h3>
                {p.summary ? <p>{p.summary}</p> : null}
                <span class="cz-more">{labels.readMore} →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <p style="margin-top:1.5rem;display:flex;flex-wrap:wrap;gap:0.75rem">
        <a class="cz-btn cz-btn-outline" href={productsHref}>{labels.exploreAll}</a>
        <a class="cz-btn cz-btn-primary" href={resourcesHref}>{labels.downloadCta || '去下载安装'}</a>
      </p>
    </div>
  </section>
) : null}

<section class="cz-section">
  <div class="cz-container">
    <div class="cz-section-head">
      <h2>{labels.compareTitle}</h2>
      <p>{labels.compareSub}</p>
    </div>
    <div class="cz-table-wrap">
      <table class="cz-table">
        <thead>
          <tr>
            <th>{labels.compareDim}</th>
            <th>{labels.compareColOld}</th>
            <th>{labels.compareColNew}</th>
          </tr>
        </thead>
        <tbody>
          {compareRows.map((row) => (
            <tr>
              <td>{row.dim}</td>
              <td>{row.old}</td>
              <td>{row.neu}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="cz-section cz-section-alt">
  <div class="cz-container">
    <div class="cz-section-head">
      <h2>{labels.stepsTitle}</h2>
      <p>{labels.stepsSub}</p>
    </div>
    <div class="cz-steps">
      {steps.map((s) => (
        <article class="cz-card">
          <div class="cz-step-num">{s.n}</div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="cz-section">
  <div class="cz-container">
    <div class="cz-section-head">
      <h2>{labels.rolesTitle}</h2>
      <p>{labels.rolesSub || ''}</p>
    </div>
    <div class="cz-role-grid">
      {roles.map((r) => (
        <article class="cz-card">
          <h3>{r.title}</h3>
          <p>{r.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="cz-cta">
  <div class="cz-container cz-cta-inner">
    <div>
      <h2>{ctaTitle}</h2>
      {ctaSub ? <p>{ctaSub}</p> : null}
    </div>
    <a class="cz-btn cz-btn-primary cz-btn-lg" href={ctaUrl}>{ctaLabel}</a>
  </div>
</section>
