---
import type { CompanyView } from '@/modules/company';

interface Props {
  company: CompanyView;
}
const { company } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <strong>{company.name}</strong>
    {company.slogan ? <p class="muted">{company.slogan}</p> : null}
    <div class="footer-meta muted">
      {company.address ? <p>{company.address}</p> : null}
      {company.phone ? <p>{company.phone}</p> : null}
      {company.email ? <p><a href={`mailto:${company.email}`}>{company.email}</a></p> : null}
      {company.website ? <p><a href={company.website} rel="noopener noreferrer">{company.website}</a></p> : null}
    </div>
  </div>
</footer>
