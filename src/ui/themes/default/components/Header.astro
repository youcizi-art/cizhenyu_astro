---
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { NavLink } from '@/modules/nav';
import type { CompanyView } from '@/modules/company';

interface Props {
  siteName: string;
  links: NavLink[];
  localeOptions?: Array<{ code: string; name: string; href: string; active: boolean }>;
  company?: CompanyView;
  contactHref?: string;
  contactLabel?: string;
  homeHref?: string;
  showContactCta?: boolean;
}
const {
  siteName,
  links,
  localeOptions = [],
  company,
  contactHref = '/contact',
  contactLabel = '提交询盘',
  homeHref = '/',
  showContactCta = true,
} = Astro.props;

const logoUrl = String(company?.logoUrl || '').trim();
const pathname = Astro.url.pathname;
const activeLocale = localeOptions.find((l) => l.active);
---
<header class="cz-header">
  <div class="cz-container cz-header-inner">
    <a class="cz-brand" href={homeHref} aria-label={siteName}>
      {logoUrl ? (
        <OptimizedImage src={logoUrl} alt={siteName} width={140} height={36} widths={[140, 280]} sizes="140px" priority />
      ) : (
        <>
          <span class="cz-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13 2 4 14h7l-1 8 10-14h-7l0-6z" />
            </svg>
          </span>
          <span>{siteName}</span>
        </>
      )}
    </a>

    <nav class="cz-nav" aria-label="Primary">
      {links.map((link) => {
        const normalizePath = (p: string) => p.replace(/\/+$/, '') || '/';
        const currentPath = normalizePath(pathname);
        const targetPath = normalizePath(link.href);
        const isHomeLink =
          targetPath === normalizePath(homeHref) ||
          targetPath === '/' ||
          /^\/[a-z]{2}(-[a-z]{2})?$/i.test(targetPath);
        const active = isHomeLink
          ? currentPath === targetPath
          : (currentPath === targetPath || currentPath.startsWith(`${targetPath}/`));
        const kids = link.children || [];
        if (kids.length) {
          return (
            <details class={`cz-nav-item${active ? ' is-active' : ''}`}>
              <summary class="cz-nav-summary">
                <span>{link.label}</span>
                <svg class="cz-nav-arrow" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="cz-nav-drop">
                {kids.map((child) => (
                  <a href={child.href}>{child.label}</a>
                ))}
              </div>
            </details>
          );
        }
        return (
          <a
            href={link.href}
            class={active ? 'is-active' : undefined}
            target={link.openInNewTab ? '_blank' : undefined}
            rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="cz-header-actions">
      {localeOptions.length > 1 ? (
        <div class="cz-lang">
          <label class="sr-only" for="cz-lang">Language</label>
          <select
            id="cz-lang"
            onchange="if (this.value) location.href=this.value"
            aria-label="Language"
          >
            {localeOptions.map((opt) => (
              <option value={opt.href} selected={opt.active}>{opt.code}</option>
            ))}
          </select>
        </div>
      ) : null}
      {showContactCta ? (
        <a class="cz-btn cz-btn-primary" href={contactHref}>{contactLabel}</a>
      ) : null}
      <button class="cz-menu-toggle" type="button" aria-label="Menu" data-cz-menu>
        Menu
      </button>
    </div>
  </div>
  <div class="cz-container cz-drawer" data-cz-drawer>
    {links.map((link) => (
      <>
        <a href={link.href}>{link.label}</a>
        {(link.children || []).map((child) => (
          <a class="cz-drawer-sub" href={child.href}>{child.label}</a>
        ))}
      </>
    ))}
    {showContactCta ? <a href={contactHref}>{contactLabel}</a> : null}
    {activeLocale ? <p class="muted" style="margin-top:0.75rem;font-size:0.8rem">{activeLocale.name}</p> : null}
  </div>
</header>
<script>
  const btn = document.querySelector('[data-cz-menu]');
  const drawer = document.querySelector('[data-cz-drawer]');
  btn?.addEventListener('click', () => drawer?.classList.toggle('is-open'));
</script>
<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
