---
/**
 * 首页主题内容切换。新主题在此增加分支；pages 只调 ActiveHome。
 * 展示数据一律来自 CMS（load-home）；禁止 theme 内假数据兜底。
 */
import AlertBanner from '@/ui/blocks/AlertBanner.astro';
import CardSection from '@/ui/blocks/CardSection.astro';
import DefaultHomePage from './default/pages/HomePage.astro';
import TurmillHomePage from './turmill/pages/HomePage.astro';
import { getThemeMeta } from './theme-ui';
import { defaultHomeLabels } from './default/home-copy';
import { turmillHomeLabels } from './turmill/home-copy';

interface Props {
  data: Awaited<ReturnType<typeof import('@/workflows/home/load-home').loadHomePage>>;
}
const { data } = Astro.props;
const meta = getThemeMeta(data.site.theme);
const defaultLabels = meta.id === 'default' ? defaultHomeLabels(data.locale) : null;
const turmillLabels = meta.id === 'turmill' ? turmillHomeLabels(data.locale) : null;
---
{meta.id === 'default' && defaultLabels ? (
  <DefaultHomePage
    siteName={data.siteName}
    hero={data.hero}
    heroImageUrl={data.heroImageUrl || data.hero?.imageUrl || ''}
    tagline={data.tagline}
    products={data.products}
    company={data.company}
    companyIntro={data.companyIntro}
    ctaBanner={data.ctaBanner}
    advantages={data.advantages}
    labels={{ ...data.labels, ...defaultLabels }}
    paths={{
      about: data.paths.about,
      contact: data.paths.contact,
      products: data.paths.products,
      solutions: data.paths.solutions,
    }}
    error={data.error}
    warnings={data.warnings}
    showProducts={data.site.modules.products}
  />
) : meta.id === 'turmill' && turmillLabels ? (
  <TurmillHomePage
    siteName={data.siteName}
    hero={data.hero}
    heroImageUrl={data.heroImageUrl || data.hero?.imageUrl || ''}
    tagline={data.tagline}
    products={data.products}
    caseStudies={data.caseStudies}
    articles={data.articles}
    solutions={data.solutions}
    company={data.company}
    companyIntro={data.companyIntro}
    companyStats={data.companyStats}
    ctaBanner={data.ctaBanner}
    advantages={data.advantages}
    testimonials={data.testimonials}
    factoryItems={data.factoryItems}
    heroThumbs={[]}
    labels={{ ...data.labels, ...turmillLabels }}
    paths={{
      about: data.paths.about,
      contact: data.paths.contact,
      products: data.paths.products,
      solutions: data.paths.solutions,
    }}
    error={data.error}
    warnings={data.warnings}
    showProducts={data.site.modules.products}
    showArticles={data.site.modules.articles}
  />
) : (
  <>
    <AlertBanner messages={data.error ? [data.error] : []} />
    <AlertBanner messages={data.warnings} tone="warn" />
    {data.hero ? (
      <section class="hero">
        {data.hero.eyebrow ? <p class="eyebrow">{data.hero.eyebrow}</p> : null}
        <h1>{data.hero.title || data.siteName}</h1>
        {data.hero.subtitle || data.tagline ? <p class="muted">{data.hero.subtitle || data.tagline}</p> : null}
        {data.hero.summary ? <p>{data.hero.summary}</p> : null}
        {data.hero.ctaLabel && data.hero.ctaUrl ? (
          <p><a class="hero-cta" href={data.hero.ctaUrl}>{data.hero.ctaLabel}</a></p>
        ) : null}
      </section>
    ) : (
      <section>
        <h1>{data.siteName}</h1>
        {data.tagline ? <p class="muted">{data.tagline}</p> : null}
      </section>
    )}
    {data.featuredRefs?.length ? (
      <CardSection
        title={data.labels.featured || '推荐'}
        items={data.featuredRefs.map((i) => ({
          href: i.href,
          title: i.title,
          summary: i.description || i.subtitle,
          coverUrl: i.coverUrl,
        }))}
      />
    ) : null}
    {data.companyIntro ? (
      <section class="section card">
        <h2>{data.labels.about || 'About'}</h2>
        {data.company.logoUrl ? (
          <p><img src={data.company.logoUrl} alt={data.siteName} style="max-height:64px" /></p>
        ) : null}
        <p>{data.companyIntro}</p>
      </section>
    ) : null}
    {data.site.modules.products ? (
      <CardSection
        title={data.labels.products}
        items={data.products.map((i) => ({
          href: i.href,
          title: i.title,
          summary: i.summary,
          meta: i.sku ? `SKU: ${i.sku}` : '',
          coverUrl: i.coverUrl,
        }))}
        emptyText={data.labels.emptyProducts}
      />
    ) : null}
    {data.site.modules.articles ? (
      <CardSection
        title={data.labels.articles}
        items={data.articles.map((i) => ({
          href: i.href,
          title: i.title,
          summary: i.summary,
          meta: i.author,
          coverUrl: i.coverUrl,
        }))}
      />
    ) : null}
  </>
)}
