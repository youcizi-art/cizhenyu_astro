---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import ProductSeoSections from '@/ui/blocks/ProductSeoSections.astro';
import type { ProductDetail } from '@/modules/product';

interface Props {
  product: ProductDetail | null;
  backHref: string;
  backLabel?: string;
  homeHref: string;
  homeLabel?: string;
  listLabel?: string;
  specsTitle?: string;
  inquiryTitle?: string;
  inquiryBody?: string;
  contactHref?: string;
  contactLabel?: string;
  sectionLabels?: Record<string, string>;
  error?: string;
  warnings?: string[];
}

const {
  product,
  backHref,
  backLabel = '← Products',
  homeHref,
  homeLabel = 'Home',
  listLabel = 'Products',
  specsTitle = 'Technical Specifications',
  inquiryTitle = 'Request Wholesale Pricing & Catalog',
  inquiryBody = 'Contact our engineering team for datasheet, MOQ, OEM customization and delivery lead times.',
  contactHref = '/contact',
  contactLabel = 'Inquire Now',
  sectionLabels = {},
  error,
  warnings = [],
} = Astro.props;

const images = product?.imageUrls?.length
  ? product.imageUrls
  : product?.coverUrl
    ? [product.coverUrl]
    : [];
const mainImage = images[0] || '';
const thumbs = images;
const inquiryTarget = product?.inquiryHref || contactHref || backHref;
---

<PageBanner
  title={product?.title || listLabel}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: listLabel, href: backHref },
    { label: product?.title || listLabel },
  ]}
/>

<section class="nrg-section">
  <div class="nrg-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />

    {product ? (
      <div class="nrg-detail-grid">
        <div class="nrg-gallery" data-nrg-gallery>
          <div class="nrg-gallery-main">
            {mainImage ? (
              <OptimizedImage
                class="nrg-gallery-main-img"
                src={mainImage}
                alt={product.title}
                width={800}
                height={800}
                priority
              />
            ) : (
              <div class="nrg-media-empty">No Image</div>
            )}
          </div>

          {thumbs.length > 1 ? (
            <div class="nrg-gallery-thumbs">
              {thumbs.map((src, idx) => (
                <button
                  type="button"
                  class={`nrg-gallery-thumb ${idx === 0 ? 'is-active' : ''}`}
                  data-nrg-thumb
                  data-src={src}
                  aria-label={`Image ${idx + 1}`}
                >
                  <OptimizedImage src={src} alt="" width={100} height={100} fill />
                </button>
              ))}
            </div>
          ) : null}
        </div>

        <div>
          {product.sku ? <span class="nrg-eyebrow">MODEL: {product.sku}</span> : null}
          <h1 class="nrg-title" style="margin-bottom: var(--sp-3)">{product.title}</h1>
          {product.summary ? <p class="nrg-lead" style="margin-bottom: var(--sp-4)">{product.summary}</p> : null}

          {product.specs?.length ? (
            <div class="nrg-specs-wrap">
              <div class="nrg-specs-title">{specsTitle}</div>
              <table class="nrg-specs-table">
                <tbody>
                  {product.specs.map((row) => (
                    <tr>
                      <th>{row.key}</th>
                      <td>{row.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : null}

          {product.descriptionHtml ? (
            <div class="nrg-prose" style="margin-top: var(--sp-6)" set:html={product.descriptionHtml} />
          ) : null}

          <div class="nrg-pseo-wrap">
            <ProductSeoSections
              product={{ ...product, inquiryHref: '', inquiryLabel: '' }}
              labels={{
                ...sectionLabels,
                inquiryTitle: '',
                inquiryBody: '',
                inquiryCta: '',
              }}
              classPrefix="nrg-pseo"
            />
          </div>

          <div class="nrg-inquiry-box">
            <h3>{inquiryTitle}</h3>
            <p>{inquiryBody}</p>
            <div style="display:flex;gap:var(--sp-3)">
              <a class="nrg-btn nrg-btn--primary" href={inquiryTarget}>{contactLabel}</a>
              <a class="nrg-btn nrg-btn--outline" href={backHref}>{backLabel}</a>
            </div>
          </div>
        </div>
      </div>
    ) : null}
  </div>
</section>

<script>
  const root = document.querySelector('[data-nrg-gallery]');
  const main = root?.querySelector('img.nrg-gallery-main-img');
  const thumbs = root?.querySelectorAll('[data-nrg-thumb]');
  thumbs?.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src');
      if (!src || !(main instanceof HTMLImageElement)) return;
      main.src = src;
      main.removeAttribute('srcset');
      thumbs.forEach((t) => t.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });
</script>
