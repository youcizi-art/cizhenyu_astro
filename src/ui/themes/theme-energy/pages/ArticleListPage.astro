---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { ArticleCard } from '@/modules/article';

interface Props {
  title: string;
  items: ArticleCard[];
  homeHref: string;
  homeLabel?: string;
  emptyText?: string;
  readMoreText?: string;
  typeLinks?: Array<{ label: string; href: string; active?: boolean }>;
  error?: string;
  warnings?: string[];
}

const {
  title,
  items,
  homeHref,
  homeLabel = 'Home',
  emptyText = 'No articles found.',
  readMoreText = 'Read Article →',
  typeLinks = [],
  error,
  warnings = [],
} = Astro.props;
---

<PageBanner
  title={title}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: title },
  ]}
/>

<section class="nrg-section">
  <div class="nrg-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />

    {typeLinks.length ? (
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-bottom:2rem">
        {typeLinks.map((t) => (
          <a
            class={`nrg-btn ${t.active ? 'nrg-btn--primary' : 'nrg-btn--outline'} nrg-btn--sm`}
            href={t.href}
          >
            {t.label}
          </a>
        ))}
      </div>
    ) : null}

    {items.length ? (
      <div class="nrg-grid nrg-grid--3">
        {items.map((item) => (
          <a class="nrg-card" href={item.href}>
            <div class="nrg-card__media">
              {item.coverUrl ? (
                <OptimizedImage src={item.coverUrl} alt={item.title} width={480} height={320} />
              ) : (
                <div class="nrg-media-empty" />
              )}
            </div>
            <div class="nrg-card__body">
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <div style="margin-top:auto;padding-top:1rem">
                <span class="nrg-link-arrow">{readMoreText}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p style="text-align:center;color:var(--muted);padding:3rem 0">{emptyText}</p>
    )}
  </div>
</section>
