---
import PageBanner from '../components/PageBanner.astro';
import Alerts from '../components/Alerts.astro';
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { CaseStudyCard } from '@/modules/case-study';

interface Props {
  title: string;
  items: CaseStudyCard[];
  homeHref: string;
  homeLabel?: string;
  emptyText?: string;
  error?: string;
  warnings?: string[];
}

const {
  title,
  items,
  homeHref,
  homeLabel = 'Home',
  emptyText = 'No case studies found.',
  error,
  warnings = [],
} = Astro.props;
---

<PageBanner
  title={title}
  crumbs={[
    { label: homeLabel, href: homeHref },
    { label: title },
  ]}
/>

<section class="nrg-section">
  <div class="nrg-container">
    <Alerts messages={error ? [error] : []} />
    <Alerts messages={warnings} tone="warn" />

    {items.length ? (
      <div class="nrg-grid nrg-grid--3">
        {items.map((item) => (
          <a class="nrg-card" href={item.href}>
            <div class="nrg-card__media">
              {item.coverUrl ? (
                <OptimizedImage src={item.coverUrl} alt={item.title} width={480} height={320} />
              ) : (
                <div class="nrg-media-empty" />
              )}
            </div>
            <div class="nrg-card__body">
              {item.industry ? <span class="nrg-card__meta">{item.industry}</span> : null}
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p style="text-align:center;color:var(--muted);padding:3rem 0">{emptyText}</p>
    )}
  </div>
</section>
