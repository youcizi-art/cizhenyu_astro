---
import OptimizedImage from '@/ui/components/OptimizedImage.astro';

interface Item {
  href: string;
  title: string;
  summary?: string;
  meta?: string;
  coverUrl?: string;
}
interface Props {
  title: string;
  items: Item[];
  emptyText?: string;
}
const { title, items, emptyText = '暂无内容。' } = Astro.props;
---
<section class="section">
  <h2>{title}</h2>
  {items.length ? (
    <div class="card-list">
      {items.map((item) => (
        <article class="card">
          {item.coverUrl ? (
            <OptimizedImage
              class="card-media"
              src={item.coverUrl}
              alt={item.title}
              width={640}
              height={400}
              widths={[320, 640, 960]}
              sizes="(max-width: 768px) 100vw, 320px"
            />
          ) : null}
          <h3><a href={item.href}>{item.title}</a></h3>
          {item.meta ? <p class="muted">{item.meta}</p> : null}
          {item.summary ? <p>{item.summary}</p> : null}
        </article>
      ))}
    </div>
  ) : (
    <p class="muted">{emptyText}</p>
  )}
</section>
