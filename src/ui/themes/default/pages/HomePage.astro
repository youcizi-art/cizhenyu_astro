---
import OptimizedImage from '@/ui/components/OptimizedImage.astro';
import type { ProductCard } from '@/modules/product';
import { defaultHomeContent } from '../home-content';
import { productSectionTitle } from '../home-copy';

interface Props {
  siteName: string;
  locale: string;
  products: ProductCard[];
  labels: Record<string, string>;
  paths: {
    about: string;
    contact: string;
    products?: string;
    solutions?: string;
  };
  error?: string;
  warnings?: string[];
  showProducts?: boolean;
}

const {
  siteName,
  locale,
  products = [],
  labels,
  paths,
  error,
  warnings = [],
  showProducts = true,
} = Astro.props;

const copy = defaultHomeContent(locale);
const contactHref = paths.contact;
const productsHref = paths.products || contactHref;

const productBySlug = new Map(products.map((p) => [p.slug, p]));

function productHref(slug: string, intent: string) {
  const card = productBySlug.get(slug);
  if (card?.href) return card.href;
  return `${contactHref}?intent=${intent}`;
}

function productCover(slug: string) {
  return productBySlug.get(slug)?.coverUrl || '';
}

const faqs = copy.faq.items;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

{(error || warnings.length) ? (
  <div class="cz-container" style="padding-top:1rem">
    {error ? <p class="cz-card cz-alert-error">{error}</p> : null}
    {warnings.map((w) => (
      <p class="cz-card cz-alert-warning">{w}</p>
    ))}
  </div>
) : null}

<!-- Hero -->
<section class="cz-hero cz-home-hero">
  <div class="cz-container cz-home-hero-inner">
    <p class="cz-home-brand">{siteName}</p>
    <p class="cz-home-brand-line">{copy.brandLine}</p>
    <h1 class="cz-hero-heading">{copy.hero.title}</h1>
    <p class="cz-hero-lead">{copy.hero.lead}</p>
    <div class="cz-hero-actions">
      <a class="cz-btn cz-btn-primary cz-btn-lg" href={`${contactHref}?intent=sites`}>
        <span>{copy.hero.ctaPrimary}</span>
        <svg class="cz-btn-arrow" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
      </a>
      <a class="cz-btn cz-btn-ghost cz-btn-lg" href={`${contactHref}?intent=crm`}>{copy.hero.ctaSecondary}</a>
    </div>
    <ul class="cz-home-highlights">
      {copy.hero.highlights.map((h) => (
        <li>
          <strong>{h.title}</strong>
          <span>{h.desc}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Pain -->
<section class="cz-section cz-home-pain">
  <div class="cz-container">
    <div class="cz-section-head cz-section-head-wide">
      <h2>{copy.pain.title}</h2>
    </div>
    <div class="cz-home-pain-grid">
      {copy.pain.items.map((item, idx) => (
        <article class="cz-home-pain-item">
          <span class="cz-home-num">0{idx + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </article>
      ))}
    </div>
    <div class="cz-home-bridge">
      <p class="cz-home-bridge-title">{copy.pain.bridge}</p>
      <p>{copy.pain.bridgeLead}</p>
    </div>
  </div>
</section>

<!-- Products -->
{showProducts ? (
  <section class="cz-section cz-section-alt cz-home-products" id="products">
    <div class="cz-container">
      <div class="cz-section-head cz-section-head-wide">
        <h2>{copy.products.title}</h2>
      </div>
      {copy.products.items.map((item, i) => {
        const cover = productCover(item.slug);
        const href = productHref(item.slug, item.slug.includes('inquiry') ? 'crm' : item.slug.includes('growth') ? 'growth' : 'sites');
        const reverse = i % 2 === 1;
        return (
          <article class:list={['cz-home-product', reverse && 'is-reverse']}>
            <div class="cz-home-product-copy">
              <p class="cz-home-product-index">{productSectionTitle(locale, item.index)}</p>
              <p class="cz-home-product-tag">{item.tag}</p>
              <h3>{item.title}</h3>
              <p class="cz-home-product-suit">{item.suit}</p>
              <ul class="cz-home-feature-list">
                {item.features.map((f) => (
                  <li>
                    <strong>{f.title}</strong>
                    <span>{f.desc}</span>
                  </li>
                ))}
              </ul>
              <p class="cz-home-product-value">{item.value}</p>
              <a class="cz-btn cz-btn-primary" href={href}>{item.cta}</a>
            </div>
            <div class="cz-home-product-visual">
              {cover ? (
                <OptimizedImage
                  src={cover}
                  alt={item.tag}
                  width={720}
                  height={480}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 900px) 100vw, 420px"
                />
              ) : (
                <div class="cz-home-product-placeholder">
                  <span>{item.index}</span>
                  <strong>{item.tag}</strong>
                </div>
              )}
            </div>
          </article>
        );
      })}
      <div class="cz-home-products-more">
        <a class="cz-btn cz-btn-outline" href={productsHref}>{labels.exploreAll}</a>
      </div>
    </div>
  </section>
) : null}

<!-- Architecture -->
<section class="cz-section cz-home-arch">
  <div class="cz-container">
    <div class="cz-section-head cz-section-head-wide">
      <h2>{copy.architecture.title}</h2>
    </div>
    <div class="cz-home-arch-list">
      {copy.architecture.items.map((item, idx) => (
        <article class="cz-home-arch-item">
          <span class="cz-home-num">0{idx + 1}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="cz-home-note">{copy.architecture.note}</p>
  </div>
</section>

<!-- Compare -->
<section class="cz-section cz-section-alt cz-home-compare">
  <div class="cz-container">
    <div class="cz-section-head cz-section-head-wide">
      <h2>{copy.compare.title}</h2>
      <p>{copy.compare.lead}</p>
    </div>
    <div class="cz-table-wrap">
      <table class="cz-table cz-home-table">
        <thead>
          <tr>
            <th>{copy.compare.colPlan}</th>
            <th>{copy.compare.colGet}</th>
            <th>{copy.compare.colCost}</th>
          </tr>
        </thead>
        <tbody>
          {copy.compare.rows.map((row, idx) => (
            <tr class:list={[idx === copy.compare.rows.length - 1 && 'is-highlight']}>
              <td>
                <strong>{row.plan}</strong>
                {idx === copy.compare.rows.length - 1 ? (
                  <span class="cz-home-rec">{labels.compareHighlight}</span>
                ) : null}
              </td>
              <td>{row.get}</td>
              <td>{row.cost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="cz-home-why">
      <h3>{copy.compare.whyTitle}</h3>
      <p>{copy.compare.whyBody}</p>
    </div>
  </div>
</section>

<!-- SEO / GEO -->
<section class="cz-section cz-home-seo">
  <div class="cz-container">
    <div class="cz-section-head cz-section-head-wide">
      <h2>{copy.seoGeo.title}</h2>
      <p>{copy.seoGeo.lead}</p>
    </div>
    <div class="cz-home-steps">
      {copy.seoGeo.steps.map((s) => (
        <article class="cz-home-step">
          <span class="cz-home-step-index">{s.index}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </article>
      ))}
    </div>
    <p class="cz-home-goal">{copy.seoGeo.goal}</p>
    <p class="cz-home-note">{copy.seoGeo.disclaimer}</p>
  </div>
</section>

<!-- Paths -->
<section class="cz-section cz-section-alt cz-home-paths">
  <div class="cz-container">
    <div class="cz-section-head cz-section-head-wide">
      <h2>{copy.paths.title}</h2>
    </div>
    <div class="cz-home-path-grid">
      {copy.paths.items.map((item) => (
        <a class="cz-home-path" href={`${contactHref}?intent=${item.intent}`}>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
          <span>{item.cta} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="cz-section cz-home-faq" id="faq">
  <div class="cz-container">
    <div class="cz-section-head">
      <p class="cz-section-eyebrow">{labels.faqEyebrow}</p>
      <h2>{copy.faq.title}</h2>
    </div>
    <div class="cz-faq-wrap">
      {faqs.map((f, idx) => (
        <details class="cz-faq-item" open={idx === 0}>
          <summary class="cz-faq-q">
            <span><em>{String(idx + 1).padStart(2, '0')}</em> {f.question}</span>
            <svg class="cz-faq-icon" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </summary>
          <div class="cz-faq-a">
            <p>{f.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cz-cta cz-home-cta">
  <div class="cz-container cz-cta-inner">
    <div class="cz-cta-text">
      <h2>{copy.cta.title}</h2>
      <p>{copy.cta.lead}</p>
    </div>
    <div class="cz-cta-buttons">
      <a class="cz-btn cz-btn-primary cz-btn-lg" href={`${contactHref}?intent=consult`}>{copy.cta.button}</a>
    </div>
  </div>
</section>
