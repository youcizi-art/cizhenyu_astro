---
interface Props {
  companyName?: string;
  slogan?: string;
  summary?: string;
  logoUrl?: string;
  aboutHref?: string;
  aboutLabel?: string;
  stats?: Array<{ label: string; value: string }>;
}
const {
  companyName = '',
  slogan = '',
  summary = '',
  logoUrl = '',
  aboutHref = '',
  aboutLabel = 'About us',
  stats = [],
} = Astro.props;
const hasContent = Boolean(companyName || summary || slogan);
---
{hasContent ? (
  <section class="tm-section tm-section-white" id="about">
    <div class="tm-title-wrap">
      <h2 class="tm-title-main">{companyName || aboutLabel}</h2>
      {slogan ? <p class="tm-title-desc">{slogan}</p> : null}
    </div>
    <div class="tm-container tm-about-grid">
      <div class="tm-about-copy">
        {summary ? <p class="tm-about-lead">{summary}</p> : null}
        {stats.length ? (
          <div class="tm-about-stats">
            {stats.slice(0, 4).map((stat) => (
              <div class="tm-about-stat">
                <div class="tm-about-stat-label">{stat.label}</div>
                <div class="tm-about-stat-value">{stat.value}</div>
              </div>
            ))}
          </div>
        ) : null}
        {aboutHref ? (
          <p style="margin-top:1.5rem">
            <a class="tm-btn tm-btn-md tm-btn-primary" href={aboutHref}>{aboutLabel}</a>
          </p>
        ) : null}
      </div>
      <aside class="tm-about-panel">
        {logoUrl ? <img src={logoUrl} alt={companyName} /> : null}
        <strong class="tm-display" style="display:block;font-size:1.35rem;color:var(--color-text-main)">{companyName}</strong>
        {slogan ? <p style="margin:0.5rem 0 0;color:var(--color-text-muted);font-size:0.95rem">{slogan}</p> : null}
      </aside>
    </div>
  </section>
) : null}
